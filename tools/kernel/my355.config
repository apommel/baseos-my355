# CONFIG_REGULATOR_PF8X00 is not set
# CONFIG_REGULATOR_PFUZE100 is not set
# CONFIG_REGULATOR_QCOM_SPMI is not set
# CONFIG_REGULATOR_RAA215300 is not set
# CONFIG_RTC_DRV_DS3232 is not set
# CONFIG_RTC_DRV_PL031 is not set
# CONFIG_RTC_DRV_IMX_BBM_SCMI is not set
# CONFIG_GPIO_DWAPB is not set
# CONFIG_GPIO_MB86S7X is not set
# CONFIG_GPIO_PL061 is not set
# CONFIG_GPIO_XGENE is not set
# CONFIG_GPIO_MAX732X is not set
# CONFIG_GPIO_PCA953X is not set
# CONFIG_PINCTRL_SINGLE is not set
# CONFIG_I2C_MUX_PCA954x is not set
# CONFIG_I2C_DESIGNWARE_PLATFORM is not set
# CONFIG_SERIAL_AMBA_PL011 is not set
# CONFIG_SERIAL_XILINX_PS_UART is not set
# CONFIG_SERIAL_FSL_LPUART is not set
# CONFIG_SERIAL_FSL_LINFLEXUART is not set
# CONFIG_FSL_EDMA is not set
# CONFIG_QCOM_HIDMA_MGMT is not set
# CONFIG_QCOM_HIDMA is not set
# CONFIG_FSL_RCPM is not set
# CONFIG_SOC_TI is not set
# CONFIG_ARM_TIMER_SP804 is not set
# CONFIG_XILINX_INTC is not set
# CONFIG_RESET_TI_SYSCON is not set
# CONFIG_CLK_VEXPRESS_OSC is not set
# CONFIG_COMMON_CLK_CS2000_CP is not set
# CONFIG_COMMON_CLK_XGENE is not set
# CONFIG_COMMON_CLK_RS9_PCIE is not set
# CONFIG_COMMON_CLK_VC3 is not set
# CONFIG_COMMON_CLK_VC5 is not set
# CONFIG_ARM_SP805_WATCHDOG is not set
# CONFIG_ARM_SBSA_WATCHDOG is not set
# CONFIG_ARM_SMC_WATCHDOG is not set
# CONFIG_POWER_RESET_XGENE is not set
# CONFIG_EXTCON_USB_GPIO is not set
# CONFIG_KEYBOARD_IMX_BBM_SCMI is not set
# CONFIG_IMX_SCMI_BBM_EXT is not set

# CPU and GPU clocks go through the vendor BL31's SCMI.
CONFIG_ARM_SCMI_PROTOCOL=y
CONFIG_COMMON_CLK_SCMI=y
CONFIG_CPUFREQ_DT=y
CONFIG_ARM_ROCKCHIP_CPUFREQ_NVMEM=y
CONFIG_PM_DEVFREQ=y
CONFIG_DEVFREQ_GOV_SIMPLE_ONDEMAND=y
CONFIG_ROCKCHIP_THERMAL=y
# DDR scaling (drivers/hardware/rk3568-dmc.c), load from the DFI. The two
# fixed governors are the ones spruceOS writes to devfreq/dmc.
CONFIG_DEVFREQ_EVENT_ROCKCHIP_DFI=y
CONFIG_ARM_RK3568_DMC_DEVFREQ=y
CONFIG_DEVFREQ_GOV_PERFORMANCE=y
CONFIG_DEVFREQ_GOV_POWERSAVE=y
CONFIG_ROCKCHIP_IODOMAIN=y
CONFIG_ROCKCHIP_SARADC=y

# PMIC, RK8600 vdd_cpu, charger, power key, RTC.
CONFIG_MFD_RK8XX_I2C=y
CONFIG_REGULATOR_RK808=y
CONFIG_REGULATOR_FAN53555=y
CONFIG_CHARGER_RK817=y
CONFIG_INPUT_RK805_PWRKEY=y
CONFIG_RTC_DRV_RK808=y
CONFIG_I2C_RK3X=y
CONFIG_I2C_CHARDEV=y

# Deep sleep: BL31's mode from stock's node (drivers/hardware/rockchip-pm-config.c).
CONFIG_SUSPEND=y
CONFIG_ROCKCHIP_PM_CONFIG=y

# Display: VOP2 to the DSI panel (drivers/hardware/panel-generic-dsi.c) and HDMI.
# defconfig has the cores as modules, which would cap every driver below at =m.
CONFIG_DRM=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_DRM_ROCKCHIP=y
CONFIG_ROCKCHIP_VOP2=y
CONFIG_ROCKCHIP_DW_MIPI_DSI=y
CONFIG_ROCKCHIP_DW_HDMI=y
CONFIG_PHY_ROCKCHIP_INNO_DSIDPHY=y
CONFIG_DRM_PANEL_GENERIC_DSI=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FB_DEVICE=y
# fb0 for rcS's logo, but no console: its first modeset held init for 1.2 s,
# and the vendor kernel has none either.
# CONFIG_FRAMEBUFFER_CONSOLE is not set
CONFIG_PWM_ROCKCHIP=y
CONFIG_BACKLIGHT_PWM=y
# The alternative to the out-of-tree mali_kbase; rcS loads one or the other.
CONFIG_DRM_PANFROST=m
# libmali g29p1's GBM allocates from /dev/dma_heap/system, as on stock.
CONFIG_DMABUF_HEAPS_SYSTEM=y
CONFIG_DMABUF_HEAPS_CMA=y

# Audio: RK817 codec on I2S1, and HDMI, whose codec dw-hdmi only registers
# with I2S_AUDIO built in. The cores again, for the same reason.
CONFIG_DRM_DW_HDMI_I2S_AUDIO=y
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_SOC=y
CONFIG_SND_SOC_ROCKCHIP_I2S_TDM=y
CONFIG_SND_SOC_RK817=y
CONFIG_SND_SIMPLE_CARD=y
CONFIG_SND_SOC_SIMPLE_AMPLIFIER=y
CONFIG_SND_SOC_HDMI_CODEC=y

# Input and LEDs. GPIO_SYSFS needs EXPERT; stock software drives pins by number.
CONFIG_EXPERT=y
CONFIG_GPIO_SYSFS=y
CONFIG_GPIO_SYSFS_LEGACY=y
CONFIG_KEYBOARD_GPIO=y
CONFIG_KEYBOARD_GPIO_POLLED=y
CONFIG_KEYBOARD_ADC=y
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_JOYDEV=y
CONFIG_INPUT_UINPUT=y
CONFIG_INPUT_JOYSTICK=y
CONFIG_JOYSTICK_MIYOO_PLAYER1=y
CONFIG_INPUT_MISC=y
CONFIG_INPUT_HALL_MH248=y
CONFIG_SERIAL_DEV_BUS=y
CONFIG_LEDS_GPIO=y
CONFIG_LEDS_TRIGGER_DEFAULT_ON=y
CONFIG_LEDS_TRIGGER_TIMER=y

# Storage: both card slots, and the filesystems cards arrive with.
CONFIG_MMC_DW=y
CONFIG_MMC_DW_ROCKCHIP=y
CONFIG_EXT4_FS=y
CONFIG_VFAT_FS=y
CONFIG_EXFAT_FS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y

# USB: host for controllers, the gadget for adb (usb-gadget-adb).
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_DUAL_ROLE=y
CONFIG_USB_EHCI_HCD_PLATFORM=y
CONFIG_USB_OHCI_HCD_PLATFORM=y
CONFIG_USB_GADGET=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_F_FS=y
CONFIG_USB_HID=y
CONFIG_PHY_ROCKCHIP_INNO_USB2=y
CONFIG_PHY_ROCKCHIP_NANENG_COMBO_PHY=y

# RTL8733BU combo: Bluetooth here, WiFi out-of-tree (8733bu), stock's
# rkwifi and rtk_btusb as a layer (tools/kernel/drivers/stock).
CONFIG_BT=m
CONFIG_BT_HCIBTUSB=m
CONFIG_BT_RTL=m
CONFIG_BT_RTK_BTUSB_SHIM=m
CONFIG_MISC_RKWIFI=y
CONFIG_CFG80211=m
