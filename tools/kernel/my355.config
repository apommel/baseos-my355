# Merged over arm64 defconfig by build-kernel.sh; every line is asserted to
# survive olddefconfig.
#
# No initramfs and no module autoloading (rcS loads only the GPU driver), so
# everything the board needs to boot and run stock software is built in.

CONFIG_LOCALVERSION="-baseos"
# CONFIG_LOCALVERSION_AUTO is not set
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_SWAP=y
CONFIG_ZRAM=y
CONFIG_PREEMPT=y
CONFIG_HZ_250=y

# One SoC. Dropping the others and PCI takes most of defconfig's drivers with them.
# CONFIG_ARCH_ACTIONS is not set
# CONFIG_ARCH_AIROHA is not set
# CONFIG_ARCH_SUNXI is not set
# CONFIG_ARCH_ALPINE is not set
# CONFIG_ARCH_APPLE is not set
# CONFIG_ARCH_ARTPEC is not set
# CONFIG_ARCH_ASPEED is not set
# CONFIG_ARCH_AXIADO is not set
# CONFIG_ARCH_BCM2835 is not set
# CONFIG_ARCH_BCM_IPROC is not set
# CONFIG_ARCH_BCMBCA is not set
# CONFIG_ARCH_BRCMSTB is not set
# CONFIG_ARCH_BERLIN is not set
# CONFIG_ARCH_BITMAIN is not set
# CONFIG_ARCH_BLAIZE is not set
# CONFIG_ARCH_BST is not set
# CONFIG_ARCH_CIX is not set
# CONFIG_ARCH_EXYNOS is not set
# CONFIG_ARCH_K3 is not set
# CONFIG_ARCH_LG1K is not set
# CONFIG_ARCH_HISI is not set
# CONFIG_ARCH_KEEMBAY is not set
# CONFIG_ARCH_MEDIATEK is not set
# CONFIG_ARCH_MESON is not set
# CONFIG_ARCH_LAN969X is not set
# CONFIG_ARCH_SPARX5 is not set
# CONFIG_ARCH_MMP is not set
# CONFIG_ARCH_MVEBU is not set
# CONFIG_ARCH_LAYERSCAPE is not set
# CONFIG_ARCH_MXC is not set
# CONFIG_ARCH_S32 is not set
# CONFIG_ARCH_MA35 is not set
# CONFIG_ARCH_NPCM is not set
# CONFIG_ARCH_PENSANDO is not set
# CONFIG_ARCH_QCOM is not set
# CONFIG_ARCH_REALTEK is not set
# CONFIG_ARCH_RENESAS is not set
# CONFIG_ARCH_SEATTLE is not set
# CONFIG_ARCH_INTEL_SOCFPGA is not set
# CONFIG_ARCH_SOPHGO is not set
# CONFIG_ARCH_STM32 is not set
# CONFIG_ARCH_SYNQUACER is not set
# CONFIG_ARCH_TEGRA is not set
# CONFIG_ARCH_TESLA_FSD is not set
# CONFIG_ARCH_SPRD is not set
# CONFIG_ARCH_THUNDER is not set
# CONFIG_ARCH_THUNDER2 is not set
# CONFIG_ARCH_UNIPHIER is not set
# CONFIG_ARCH_VEXPRESS is not set
# CONFIG_ARCH_VISCONTI is not set
# CONFIG_ARCH_XGENE is not set
# CONFIG_ARCH_ZYNQMP is not set
CONFIG_ARCH_ROCKCHIP=y
# CONFIG_PCI is not set
# CONFIG_VIRTUALIZATION is not set

# CPU and GPU clocks go through the vendor BL31's SCMI.
CONFIG_ARM_SCMI_PROTOCOL=y
CONFIG_COMMON_CLK_SCMI=y
CONFIG_CPUFREQ_DT=y
CONFIG_PM_DEVFREQ=y
CONFIG_DEVFREQ_GOV_SIMPLE_ONDEMAND=y
CONFIG_ROCKCHIP_THERMAL=y
CONFIG_ROCKCHIP_IODOMAIN=y
CONFIG_ROCKCHIP_SARADC=y

# PMIC, RK8600 vdd_cpu, charger, power key, RTC.
CONFIG_MFD_RK8XX_I2C=y
CONFIG_REGULATOR_RK808=y
CONFIG_REGULATOR_FAN53555=y
CONFIG_CHARGER_RK817=y
CONFIG_INPUT_RK805_PWRKEY=y
CONFIG_RTC_DRV_RK808=y
CONFIG_I2C_RK3X=y
CONFIG_I2C_CHARDEV=y

# Display: VOP2 to the DSI panel (drivers/panel-generic-dsi.c) and HDMI.
# defconfig has the cores as modules, which would cap every driver below at =m.
CONFIG_DRM=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_DRM_ROCKCHIP=y
CONFIG_ROCKCHIP_VOP2=y
CONFIG_ROCKCHIP_DW_MIPI_DSI=y
CONFIG_ROCKCHIP_DW_HDMI=y
CONFIG_PHY_ROCKCHIP_INNO_DSIDPHY=y
CONFIG_DRM_PANEL_GENERIC_DSI=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FB_DEVICE=y
# fb0 for rcS's logo, but no console: its first modeset held init for 1.2 s,
# and the vendor kernel has none either.
# CONFIG_FRAMEBUFFER_CONSOLE is not set
CONFIG_PWM_ROCKCHIP=y
CONFIG_BACKLIGHT_PWM=y
# The alternative to the out-of-tree mali_kbase; rcS loads one or the other.
CONFIG_DRM_PANFROST=m

# Audio: RK817 codec on I2S1, and HDMI, whose codec dw-hdmi only registers
# with I2S_AUDIO built in. The cores again, for the same reason.
CONFIG_DRM_DW_HDMI_I2S_AUDIO=y
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_SOC=y
CONFIG_SND_SOC_ROCKCHIP_I2S_TDM=y
CONFIG_SND_SOC_RK817=y
CONFIG_SND_SIMPLE_CARD=y
CONFIG_SND_SOC_SIMPLE_AMPLIFIER=y
CONFIG_SND_SOC_HDMI_CODEC=y

# Input and LEDs. GPIO_SYSFS needs EXPERT; stock software drives pins by number.
CONFIG_EXPERT=y
CONFIG_GPIO_SYSFS=y
CONFIG_GPIO_SYSFS_LEGACY=y
CONFIG_KEYBOARD_GPIO=y
CONFIG_KEYBOARD_GPIO_POLLED=y
CONFIG_KEYBOARD_ADC=y
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_JOYDEV=y
CONFIG_INPUT_UINPUT=y
CONFIG_SERIAL_DEV_BUS=y
CONFIG_LEDS_GPIO=y
CONFIG_LEDS_TRIGGER_DEFAULT_ON=y
CONFIG_LEDS_TRIGGER_TIMER=y

# Storage: both card slots, and the filesystems cards arrive with.
CONFIG_MMC_DW=y
CONFIG_MMC_DW_ROCKCHIP=y
CONFIG_EXT4_FS=y
CONFIG_VFAT_FS=y
CONFIG_EXFAT_FS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y

# USB: host for controllers, the gadget for adb (usb-gadget-adb).
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_DUAL_ROLE=y
CONFIG_USB_EHCI_HCD_PLATFORM=y
CONFIG_USB_OHCI_HCD_PLATFORM=y
CONFIG_USB_GADGET=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_F_FS=y
CONFIG_USB_HID=y
CONFIG_PHY_ROCKCHIP_INNO_USB2=y
CONFIG_PHY_ROCKCHIP_NANENG_COMBO_PHY=y

# RTL8733BU combo: Bluetooth here, WiFi out-of-tree later.
CONFIG_BT=m
CONFIG_BT_HCIBTUSB=m
CONFIG_BT_RTL=m
CONFIG_CFG80211=m
