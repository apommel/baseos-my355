From a7e29f251afc9c341a288252d45fb0150bb2204d Mon Sep 17 00:00:00 2001
From: Chris Morgan <macromorgan@hotmail.com>
Date: Wed, 30 Oct 2024 17:40:28 -0500
Subject: [PATCH] arm64: dts: rockchip: Add idle-states for rk356x

Add the idle-states for the rk356x from the BSP kernel. I observed idle
power draw drop around 0.2w with this change in place on my Anbernic
RG353P device based around the rk3566 SoC.

Signed-off-by: Chris Morgan <macromorgan@hotmail.com>
---
--- a/arch/arm64/boot/dts/rockchip/rk356x-base.dtsi
+++ b/arch/arm64/boot/dts/rockchip/rk356x-base.dtsi
@@ -56,6 +56,7 @@
 			reg = <0x0 0x0>;
 			clocks = <&scmi_clk SCMI_CLK_CPU>;
 			#cooling-cells = <2>;
+			cpu-idle-states = <&CPU_SLEEP>;
 			enable-method = "psci";
 			i-cache-size = <0x8000>;
 			i-cache-line-size = <64>;
@@ -72,6 +73,7 @@
 			reg = <0x0 0x100>;
 			clocks = <&scmi_clk SCMI_CLK_CPU>;
 			#cooling-cells = <2>;
+			cpu-idle-states = <&CPU_SLEEP>;
 			enable-method = "psci";
 			i-cache-size = <0x8000>;
 			i-cache-line-size = <64>;
@@ -88,6 +90,7 @@
 			reg = <0x0 0x200>;
 			clocks = <&scmi_clk SCMI_CLK_CPU>;
 			#cooling-cells = <2>;
+			cpu-idle-states = <&CPU_SLEEP>;
 			enable-method = "psci";
 			i-cache-size = <0x8000>;
 			i-cache-line-size = <64>;
@@ -104,6 +107,7 @@
 			reg = <0x0 0x300>;
 			clocks = <&scmi_clk SCMI_CLK_CPU>;
 			#cooling-cells = <2>;
+			cpu-idle-states = <&CPU_SLEEP>;
 			enable-method = "psci";
 			i-cache-size = <0x8000>;
 			i-cache-line-size = <64>;
@@ -113,6 +117,18 @@
 			d-cache-sets = <128>;
 			next-level-cache = <&l3_cache>;
 		};
+
+		idle-states {
+			entry-method = "psci";
+			CPU_SLEEP: cpu-sleep {
+				compatible = "arm,idle-state";
+				local-timer-stop;
+				arm,psci-suspend-param = <0x0010000>;
+				entry-latency-us = <100>;
+				exit-latency-us = <120>;
+				min-residency-us = <1000>;
+			};
+		};
 	};
 
 	/*
