# BaseOS my355: bring-up diagnostics, merged over my355.config when
# MY355_UBOOT_DEBUG=1 (off by default).
#
# The boot script copies this record to the last 64 KiB of the active `boot`
# partition before handing off, and again if the hand-off fails; see
# docs/diagnostics.md. Recording starts right after relocation: what is printed
# before it is discarded there anyway, so the early variant stays off rather
# than add an allocation to the one stage with no way to report failure.
CONFIG_CONSOLE_RECORD=y
# CONFIG_CONSOLE_RECORD_INIT_F is not set
CONFIG_CONSOLE_RECORD_OUT_SIZE=0x10000
