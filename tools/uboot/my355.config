# BaseOS my355: the Kconfig delta over quartz64-a-rk3566_defconfig.
#
# quartz64-a is the base ROCKNIX and Zlyme boot this SoC with. Its board
# configuration is kept, but not its device tree (below).
#
# The configuration that booted on 2026-09-05, plus what the boot script and
# recording boot timings need since. build-uboot.sh asserts every line
# survives `make olddefconfig`.

# --- where the SPL puts us -------------------------------------------------
# The vendor FIT loads its U-Boot here and the vendor SPL loads ours, so we
# link for the address already proven on this unit. (Mainline's 0x00800000
# also works — ROCKNIX boots there — but it is not what was measured.)
CONFIG_TEXT_BASE=0x00a00000

# --- the control tree ------------------------------------------------------
# The Flip's own (dts/rk3566-miyoo-flip.dts, copied in by build-uboot.sh), not
# quartz64-a's: that one set vccio4 to 1.8 V on a board that feeds it 3.3 V,
# and described Ethernet, PCIe, USB and an SDIO controller this path never uses.
# CONFIG_OF_UPSTREAM is not set
CONFIG_DEFAULT_DEVICE_TREE="rk3566-miyoo-flip"
CONFIG_OF_LIST="rk3566-miyoo-flip"

# --- what we boot ----------------------------------------------------------
# One generated command (build-uboot.sh). -2: no delay and no key check; the
# stock 2 is two seconds listening to a UART nobody has attached.
CONFIG_BOOTDELAY=-2
CONFIG_USE_BOOTCOMMAND=y
CONFIG_HUSH_PARSER=y
CONFIG_CMD_SETEXPR=y
# `boot` is found by name, never by sector: an A/B update moves it
# (src/gptslot.c).
CONFIG_CMD_PART=y
CONFIG_EFI_PARTITION=y
# Default on, but the boot script's `blkcache configure` depends on them.
CONFIG_BLOCK_CACHE=y
CONFIG_CMD_BLOCK_CACHE=y
CONFIG_CMD_MMC=y
CONFIG_CMD_GPIO=y
CONFIG_CMD_POWEROFF=y
CONFIG_FIT=y
# 64 MiB: the vendor kernel decompresses to 35.6 MiB including its BSS.
CONFIG_SYS_BOOTM_LEN=0x4000000
CONFIG_GZIP=y
# The kernel is stored zstd-compressed. MINIFY strips zstd's fast decode paths
# to save ~50 KB: with patches/0003, 0.35 s against 0.63 s here (docs/uboot.md).
CONFIG_ZSTD=y
# CONFIG_ZSTD_LIB_MINIFY is not set

# --- measuring it ----------------------------------------------------------
# U-Boot writes its timings into the kernel's device tree at hand-off:
# /proc/device-tree/bootstage, readable with baseos-bootinfo. Arch-counter
# microseconds, so power-on-relative like the kernel's printk.
CONFIG_BOOTSTAGE=y
CONFIG_BOOTSTAGE_FDT=y
# CONFIG_BOOTSTAGE_REPORT is not set
CONFIG_CMD_MY355=y
# The kernel's tree is shrunk to its minimum before the report is added;
# patches/0002 grows it back by 4 KiB, which must stay inside this padding.
CONFIG_SYS_FDT_PAD=0x6000

# --- the scan this path exists to delete -----------------------------------
# CONFIG_BOOTSTD is not set
# CONFIG_BOOTSTD_FULL is not set
# CONFIG_CMD_BOOTFLOW is not set
# CONFIG_CMD_BOOTDEV is not set
# CONFIG_CMD_BOOTMETH is not set
# CONFIG_CMD_PXE is not set
# CONFIG_CMD_DHCP is not set
# CONFIG_EFI_LOADER is not set

# --- buses this board does not boot from -----------------------------------
# CONFIG_PCI is not set
# CONFIG_CMD_PCI is not set
# CONFIG_PCIE_DW_ROCKCHIP is not set
# CONFIG_NVME is not set
# CONFIG_NVME_PCI is not set
# CONFIG_AHCI is not set
# CONFIG_AHCI_PCI is not set
# CONFIG_SCSI is not set
# CONFIG_SCSI_AHCI is not set
# CONFIG_CMD_SCSI is not set
# CONFIG_USB is not set
# CONFIG_CMD_USB is not set
# CONFIG_USB_XHCI_HCD is not set
# CONFIG_USB_EHCI_HCD is not set
# CONFIG_USB_EHCI_GENERIC is not set
# CONFIG_USB_OHCI_HCD is not set
# CONFIG_USB_OHCI_GENERIC is not set
# CONFIG_USB_DWC3 is not set
# CONFIG_USB_DWC3_GENERIC is not set
# CONFIG_PHY_ROCKCHIP_INNO_USB2 is not set
# CONFIG_PHY_ROCKCHIP_NANENG_COMBOPHY is not set
# Networking is a Kconfig `choice`: deselected by picking the empty member.
CONFIG_NO_NET=y
# CONFIG_NET is not set
# CONFIG_DWC_ETH_QOS is not set
# CONFIG_DWC_ETH_QOS_ROCKCHIP is not set
# CONFIG_PHY_MOTORCOMM is not set

# No eMMC is populated. `mmc dev 1` still resolves to sdmmc0: the alias
# assigns the number, not the driver (rk356x-u-boot.dtsi).
# CONFIG_MMC_SDHCI is not set
# CONFIG_MMC_SDHCI_SDMA is not set
# CONFIG_MMC_SDHCI_ROCKCHIP is not set
# CONFIG_SUPPORT_EMMC_RPMB is not set

# The SPI NAND is the stock fallback, not ours. Off also stops binman
# demanding the DDR blob for an idbloader we do not build.
# CONFIG_ROCKCHIP_SFC is not set
# CONFIG_ROCKCHIP_SPI_IMAGE is not set

# UART2 at 1 500 000 baud from before relocation, for a unit with the case open.
CONFIG_DEBUG_UART=y

# --- the PMIC ---------------------------------------------------------------
# A charger that woke the board is handled by `my355 charge`, which keeps
# U-Boot up to drive the charge LED, instead of powering straight back off.
# CONFIG_ROCKCHIP_RK8XX_DISABLE_BOOT_ON_POWERON is not set
# Boot-mode handling off: it would clear `reboot charge` before the boot
# script sees it. `my355 charge` reads and clears the register itself.
CONFIG_ROCKCHIP_BOOT_MODE_REG=0x0

# --- nothing to print to, nowhere to save to -------------------------------
# CONFIG_DISPLAY_BOARDINFO is not set
# CONFIG_DISPLAY_BOARDINFO_LATE is not set
CONFIG_ENV_IS_NOWHERE=y
# CONFIG_ENV_IS_IN_FAT is not set
# CONFIG_ENV_IS_IN_MMC is not set
