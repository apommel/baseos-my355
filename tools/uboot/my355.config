# BaseOS my355 — the Kconfig delta over quartz64-a-rk3566_defconfig.
#
# quartz64-a is the base ROCKNIX uses for every RK3566 handheld, and it is not
# an arbitrary choice here either: its control device tree wires sdmmc0 exactly
# the way the Miyoo Flip is wired — vmmc on a fixed regulator at gpio0 pin 5
# active-low (the Flip's SDMMC_PWREN_L), vqmmc on the RK817's LDO_REG5, card
# detect on gpio0 pin 4 — and declares sd-uhs-sdr104 at 150 MHz. See
# docs/09-uboot.md.
#
# Everything below either makes this U-Boot boot the way BaseOS needs, or
# deletes work it would otherwise do on a device that has no PCIe, no eMMC, no
# Ethernet, no USB host in use before Linux, and no console to print to.
# build-uboot.sh asserts every line of this file survived `make olddefconfig`.

# --- where the SPL puts us -------------------------------------------------
# The vendor FIT loads its U-Boot at 0x00a00000 and the vendor SPL is the thing
# that will load ours, so we link for the same address rather than mainline's
# 0x00800000. The SPL reads each FIT image straight from the card to its `load`,
# which makes this the one address on this device already known to work.
# (Not to be confused with 0x0a000000, where U-Boot later parks the boot FIT.)
CONFIG_TEXT_BASE=0x00a00000

# --- what we boot ----------------------------------------------------------
# One fixed command against a fixed sector. -2 means no delay AND no key check,
# which matters because the stock value of 2 is two seconds spent listening to
# a UART nobody has attached.
CONFIG_BOOTDELAY=-2
CONFIG_USE_BOOTCOMMAND=y
# The boot FIT's length travels in a header sector, so setexpr reads it back.
CONFIG_CMD_SETEXPR=y
CONFIG_FIT=y
# 64 MiB: the vendor kernel decompresses to 35.6 MiB including its BSS.
CONFIG_SYS_BOOTM_LEN=0x4000000
# The lever a FIT unlocks that the vendor U-Boot's sniffing Android path cannot
# reach: 12.99 MB gzip -> 10.84 MB zstd (docs/01-boot-budget.md).
CONFIG_ZSTD=y
CONFIG_GZIP=y

# --- the scan this exercise exists to delete -------------------------------
# `bootflow scan -lb` enumerates every bootdev against every bootmeth. We know
# where the payload is.
# CONFIG_BOOTSTD is not set
# CONFIG_BOOTSTD_FULL is not set
# CONFIG_CMD_BOOTFLOW is not set
# CONFIG_CMD_BOOTDEV is not set
# CONFIG_CMD_BOOTMETH is not set
# CONFIG_CMD_PXE is not set
# CONFIG_CMD_DHCP is not set
# CONFIG_EFI_LOADER is not set

# --- buses this board does not boot from -----------------------------------
# CONFIG_PCI is not set
# CONFIG_CMD_PCI is not set
# CONFIG_PCIE_DW_ROCKCHIP is not set
# CONFIG_NVME is not set
# CONFIG_NVME_PCI is not set
# CONFIG_AHCI is not set
# CONFIG_AHCI_PCI is not set
# CONFIG_SCSI is not set
# CONFIG_SCSI_AHCI is not set
# CONFIG_CMD_SCSI is not set
# CONFIG_USB is not set
# CONFIG_CMD_USB is not set
# CONFIG_USB_XHCI_HCD is not set
# CONFIG_USB_EHCI_HCD is not set
# CONFIG_USB_EHCI_GENERIC is not set
# CONFIG_USB_OHCI_HCD is not set
# CONFIG_USB_OHCI_GENERIC is not set
# CONFIG_USB_DWC3 is not set
# CONFIG_USB_DWC3_GENERIC is not set
# CONFIG_PHY_ROCKCHIP_INNO_USB2 is not set
# CONFIG_PHY_ROCKCHIP_NANENG_COMBOPHY is not set
# Networking is a Kconfig `choice`, so it is deselected by picking the empty
# member, not by unsetting CONFIG_NET.
CONFIG_NO_NET=y
# CONFIG_NET is not set
# CONFIG_DWC_ETH_QOS is not set
# CONFIG_DWC_ETH_QOS_ROCKCHIP is not set
# CONFIG_PHY_MOTORCOMM is not set

# The eMMC pads exist on the SoC; nothing is populated on this board, and
# rk356x-u-boot.dtsi still marks &sdhci okay. Dropping the driver skips the
# probe rather than waiting for it to find nothing. `mmc dev 1` still resolves
# to sdmmc0 — the alias, not the driver, assigns the sequence number.
# CONFIG_MMC_SDHCI is not set
# CONFIG_MMC_SDHCI_SDMA is not set
# CONFIG_MMC_SDHCI_ROCKCHIP is not set
# CONFIG_SUPPORT_EMMC_RPMB is not set

# The SPI NAND holds the stock system, which is the fallback path, not ours.
# Turning off ROCKCHIP_SPI_IMAGE also stops binman demanding the proprietary
# DDR blob for an idbloader we do not build (docs/09-uboot.md).
# CONFIG_ROCKCHIP_SFC is not set
# CONFIG_ROCKCHIP_SPI_IMAGE is not set

# --- nothing to print to, nowhere to save to -------------------------------
# CONFIG_DISPLAY_BOARDINFO is not set
# CONFIG_DISPLAY_BOARDINFO_LATE is not set
CONFIG_ENV_IS_NOWHERE=y
# CONFIG_ENV_IS_IN_FAT is not set
# CONFIG_ENV_IS_IN_MMC is not set
