Add the `my355` command: named bootstage marks from the boot script, the
core clock handed to the kernel, and a copy of the console record the boot
script can save to the card. The Flip has no UART attached, so this is how
a failed boot reports what happened.

diff --git a/cmd/Kconfig b/cmd/Kconfig
index 5c611fb3..4a2533a0 100644
--- a/cmd/Kconfig
+++ b/cmd/Kconfig
@@ -1640,6 +1640,15 @@ config CMD_PART
 	  Read and display information about the partition table on
 	  various media.
 
+config CMD_MY355
+	bool "my355 - BaseOS Miyoo Flip boot helpers"
+	depends on BOOTSTAGE
+	help
+	  Named bootstage marks from the boot script, the core clock handed
+	  to the kernel and, with CONSOLE_RECORD, a copy of the console output
+	  the boot script can save to the card. For a unit with no serial
+	  console attached.
+
 config CMD_PCI
 	bool "pci - Access PCI devices"
 	help
