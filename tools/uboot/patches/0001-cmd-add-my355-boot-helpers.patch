@@ -0,0 +1,366 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * BaseOS my355 (Miyoo Flip) boot helpers. The unit has no UART attached, so
+ * the boot script records its own timings and saves its own console output.
+ */
+
+#include <bootstage.h>
+#include <clk.h>
+#include <command.h>
+#include <dm.h>
+#include <env.h>
+#include <i2c.h>
+#include <mapmem.h>
+#include <membuf.h>
+#include <asm/global_data.h>
+#include <linux/string.h>
+#include <vsprintf.h>
+#include <dt-bindings/clock/rk3568-cru.h>
+#include <linux/bitops.h>
+#include <linux/delay.h>
+#include <linux/kernel.h>
+
+DECLARE_GLOBAL_DATA_PTR;
+
+static int do_my355_mark(struct cmd_tbl *cmdtp, int flag, int argc,
+			 char *const argv[])
+{
+	char *name;
+
+	if (argc != 2)
+		return CMD_RET_USAGE;
+	/* bootstage keeps the pointer; argv does not outlive this command */
+	name = strdup(argv[1]);
+	if (!name)
+		return CMD_RET_FAILURE;
+	bootstage_mark_name(BOOTSTAGE_ID_ALLOC, name);
+
+	return CMD_RET_SUCCESS;
+}
+
+static int do_my355_log(struct cmd_tbl *cmdtp, int flag, int argc,
+			char *const argv[])
+{
+#if CONFIG_IS_ENABLED(CONSOLE_RECORD)
+	struct membuf copy;
+	ulong max;
+	char *dst, *data;
+	int i, len, total = 0;
+
+	if (argc != 3)
+		return CMD_RET_USAGE;
+	max = hextoul(argv[2], NULL);
+	dst = map_sysmem(hextoul(argv[1], NULL), max);
+	/* Drain a copy, so a second save still has everything */
+	copy = gd->console_out;
+	for (i = 0; i < 2; i++) {
+		len = membuf_getraw(&copy, max - total, true, &data);
+		memcpy(dst + total, data, len);
+		total += len;
+	}
+	unmap_sysmem(dst);
+	env_set_hex("my355_logsize", total);
+
+	return CMD_RET_SUCCESS;
+#else
+	return CMD_RET_FAILURE;
+#endif
+}
+
+/*
+ * vdd_cpu is an RK8600 on i2c0; VSEL0 is its run-time selector. The mainline
+ * clock driver leaves the cores at 816 MHz, where the vendor U-Boot hands the
+ * kernel 1104 MHz, and the kernel runs at whatever it inherits until cpufreq.
+ */
+#define RK8600_ADDR	0x40
+#define RK8600_VSEL0	0x00
+#define RK8600_ID1	0x03
+#define RK8600_ID1_VAL	0x88
+#define RK8600_EN	BIT(7)
+#define RK8600_NSEL	GENMASK(5, 0)
+#define RK8600_UV(n)	(712500 + 12500 * (n))
+#define RK8600_RAMP_UV_PER_US	2300
+
+/*
+ * The vendor OPP table's voltage per rate, from its default column (L0), which
+ * covers every silicon bin. Above 1104 MHz only for decompression: the vendor
+ * kernel sets vdd_cpu to 900 mV when its regulator probes, before cpufreq, so
+ * the boot script brings the clock back down before the hand-off.
+ */
+static const struct { ulong mhz; int uv; } my355_opps[] = {
+	{ 816, 850000 },
+	{ 1104, 900000 },
+	{ 1416, 1025000 },
+	{ 1608, 1100000 },
+	{ 1800, 1150000 },
+};
+
+static int do_my355_cpu(struct cmd_tbl *cmdtp, int flag, int argc,
+			char *const argv[])
+{
+#if IS_ENABLED(CONFIG_ROCKCHIP_RK3568)
+	struct udevice *pmic, *cru;
+	struct clk armclk;
+	ulong mhz, hz;
+	int i, uv = 0, reg, nsel, id, ret;
+
+	if (argc != 2)
+		return CMD_RET_USAGE;
+	mhz = dectoul(argv[1], NULL);
+	for (i = 0; i < ARRAY_SIZE(my355_opps); i++)
+		if (my355_opps[i].mhz == mhz)
+			uv = my355_opps[i].uv;
+	if (!uv) {
+		printf("my355 cpu: %lu MHz is not a supported rate\n", mhz);
+		return CMD_RET_FAILURE;
+	}
+
+	ret = i2c_get_chip_for_busnum(0, RK8600_ADDR, 1, &pmic);
+	id = ret ? ret : dm_i2c_reg_read(pmic, RK8600_ID1);
+	reg = ret ? ret : dm_i2c_reg_read(pmic, RK8600_VSEL0);
+	if (id != RK8600_ID1_VAL || reg < 0 || !(reg & RK8600_EN)) {
+		printf("my355 cpu: no RK8600 at i2c0 0x%x (id %d, vsel0 %d)\n",
+		       RK8600_ADDR, id, reg);
+		return CMD_RET_FAILURE;
+	}
+	nsel = reg & RK8600_NSEL;
+	printf("my355 cpu: vdd_cpu vsel0 0x%02x = %d uV\n", reg, RK8600_UV(nsel));
+	/* Raise only; never lower a rail someone else set */
+	if (RK8600_UV(nsel) < uv) {
+		int want = DIV_ROUND_UP(uv - RK8600_UV(0), 12500);
+
+		ret = dm_i2c_reg_write(pmic, RK8600_VSEL0,
+				       (reg & ~RK8600_NSEL) | want);
+		if (ret || dm_i2c_reg_read(pmic, RK8600_VSEL0) !=
+			   ((reg & ~RK8600_NSEL) | want)) {
+			printf("my355 cpu: vdd_cpu write failed\n");
+			return CMD_RET_FAILURE;
+		}
+		udelay((RK8600_UV(want) - RK8600_UV(nsel)) /
+		       RK8600_RAMP_UV_PER_US + 100);
+		printf("my355 cpu: vdd_cpu -> %d uV\n", RK8600_UV(want));
+	}
+
+	ret = uclass_get_device_by_driver(UCLASS_CLK,
+					  DM_DRIVER_GET(rockchip_rk3568_cru), &cru);
+	if (ret)
+		return CMD_RET_FAILURE;
+	armclk.dev = cru;
+	armclk.id = ARMCLK;
+	hz = mhz * 1000000;
+	/* The driver records the first ARMCLK rate and applies later ones */
+	for (i = 0; i < 2 && clk_get_rate(&armclk) != hz; i++)
+		clk_set_rate(&armclk, hz);
+	printf("my355 cpu: armclk %lu Hz\n", clk_get_rate(&armclk));
+
+	return clk_get_rate(&armclk) == hz ? CMD_RET_SUCCESS : CMD_RET_FAILURE;
+#else
+	return CMD_RET_FAILURE;
+#endif
+}
+
+/*
+ * The RK817 fuel gauge keeps its state in PMIC registers across power-off: a
+ * coulomb counter, and the SOC and capacity the kernel last saved. Left alone
+ * the kernel reads a counter that moved while off as a halted session and
+ * restarts the displayed SOC from 0 on a full battery; FG_INIT tells it to
+ * take what is written here instead, as the vendor U-Boot does.
+ *
+ * The counter does not survive a real power-off, and not by any fixed amount,
+ * so after one it is dropped in favour of PWRON_VOL, the voltage the PMIC
+ * latches as it raises the rails, read against the cell's ocv_table. OFF_CNT says which happened
+ * and is read only for whether it is zero: its step is about ten minutes, not
+ * the minute the vendor driver takes it for, so an off shorter than that still
+ * looks like a warm reboot. Register map and units from the vendor driver
+ * (fg_rk817.c), sample_res 10 mOhm from the Flip's tree; the measurements
+ * behind all this are in docs/uboot.md.
+ */
+#define RK817_ADDR		0x20
+#define RK817_ID_MSB		0xed
+#define RK817_ID_LSB		0xee
+#define RK817_ID		0x8170
+#define RK817_GG_STS		0x57
+#define RK817_BAT_CON		BIT(4)	/* battery was disconnected */
+#define RK817_PWRON_VOL_H	0x6b
+#define RK817_OFF_CNT		0x6f
+#define RK817_Q_INIT_H3		0x70
+#define RK817_Q_PRES_H3		0x74
+#define RK817_CAP_INVALID	BIT(7)
+#define RK817_VCALIB0_H		0x93
+#define RK817_VCALIB1_H		0x95
+#define RK817_SOC_REG0		0x9a
+#define RK817_REMAIN_CAP_REG0	0x9d
+#define RK817_NEW_FCC_REG0	0xa0
+#define RK817_FG_INIT		0xa5
+#define RK817_FG_INIT_DONE	BIT(7)
+#define RK817_SAMPLE_RES	10
+#define RK817_QMAX_MAH		3300	/* design_qmax */
+#define RK817_MIN_FCC		500
+/* The kernel's smoothing keeps its displayed SOC this close to the counter */
+#define RK817_MAX_DRIFT		10000	/* thousandths of a percent */
+#define RK817_FULL		100000
+/* The battery's ocv_table, 0 to 100% in 5% steps, in mV, from the Flip's tree */
+static const u16 rk817_ocv_mv[] = {
+	3378, 3426, 3469, 3500, 3525, 3547, 3566, 3587, 3609, 3638, 3676,
+	3722, 3773, 3816, 3849, 3883, 3930, 3967, 3998, 4057, 4150,
+};
+/* Outside this is not a battery reading */
+#define RK817_VOL_MIN		2500
+#define RK817_VOL_MAX		4500
+
+static int rk817_read(struct udevice *dev, uint reg, int n)
+{
+	int i, v;
+	u32 val = 0;
+
+	/* n little-endian bytes from reg, or 4 big-endian for the counters */
+	for (i = 0; i < n; i++) {
+		v = dm_i2c_reg_read(dev, reg + i);
+		if (v < 0)
+			return v;
+		val |= (u32)v << (n == 4 ? 8 * (3 - i) : 8 * i);
+	}
+	return val;
+}
+
+static int rk817_write3(struct udevice *dev, uint reg, u32 val)
+{
+	int i, ret = 0;
+
+	for (i = 0; i < 3 && !ret; i++)
+		ret = dm_i2c_reg_write(dev, reg + i, (val >> (8 * i)) & 0xff);
+	return ret;
+}
+
+/* The voltage registers are a big-endian pair, high byte first */
+static int rk817_read_be16(struct udevice *dev, uint reg)
+{
+	int hi = dm_i2c_reg_read(dev, reg);
+	int lo = dm_i2c_reg_read(dev, reg + 1);
+
+	if (hi < 0 || lo < 0)
+		return -1;
+	return hi << 8 | lo;
+}
+
+/*
+ * SOC from PWRON_VOL in thousandths of a percent, or -1 if unreadable. The
+ * raw-to-mV pair follows the kernel's rk817_bat_init_voltage_kb() exactly,
+ * truncation included, so both land on the same millivolt.
+ */
+static int rk817_ocv_soc(struct udevice *dev)
+{
+	int cal0 = rk817_read_be16(dev, RK817_VCALIB0_H);
+	int cal1 = rk817_read_be16(dev, RK817_VCALIB1_H);
+	int raw = rk817_read_be16(dev, RK817_PWRON_VOL_H);
+	int step = RK817_FULL / (ARRAY_SIZE(rk817_ocv_mv) - 1);
+	int k, b, mv, i;
+
+	if (cal0 < 0 || cal1 < 0 || raw < 0 || cal1 == cal0)
+		return -1;
+	k = (4025 - 2300) * 1000 / (cal1 - cal0);
+	b = 4025 - k * cal1 / 1000;
+	mv = k * raw / 1000 + b;
+	if (mv < RK817_VOL_MIN || mv > RK817_VOL_MAX)
+		return -1;
+
+	if (mv <= rk817_ocv_mv[0])
+		return 0;
+	for (i = 1; i < ARRAY_SIZE(rk817_ocv_mv); i++)
+		if (mv < rk817_ocv_mv[i])
+			return (i - 1) * step +
+			       (mv - rk817_ocv_mv[i - 1]) * step /
+			       (rk817_ocv_mv[i] - rk817_ocv_mv[i - 1]);
+	return RK817_FULL;
+}
+
+static int do_my355_fg(struct cmd_tbl *cmdtp, int flag, int argc,
+		       char *const argv[])
+{
+	struct udevice *pmic;
+	int id, sts, off, fcc, pre_soc, pre_cap, now_cap, soc, cap, cnt_soc;
+	int ocv_soc;
+	bool by_ocv = false;
+	u32 q, adc;
+	int i, ret;
+
+	ret = i2c_get_chip_for_busnum(0, RK817_ADDR, 1, &pmic);
+	id = ret ? ret : (dm_i2c_reg_read(pmic, RK817_ID_MSB) << 8 |
+			  dm_i2c_reg_read(pmic, RK817_ID_LSB));
+	if (id < 0 || (id & 0xfff0) != RK817_ID) {
+		printf("my355 fg: no RK817 at i2c0 0x%x (%d)\n", RK817_ADDR, id);
+		return CMD_RET_FAILURE;
+	}
+	/* A disconnected battery has no history: the kernel estimates from voltage */
+	sts = dm_i2c_reg_read(pmic, RK817_GG_STS);
+	if (sts < 0 || (sts & RK817_BAT_CON)) {
+		printf("my355 fg: first power-on, left to the kernel\n");
+		return CMD_RET_SUCCESS;
+	}
+	q = rk817_read(pmic, RK817_Q_PRES_H3, 4);
+	fcc = rk817_read(pmic, RK817_NEW_FCC_REG0, 3);
+	pre_soc = rk817_read(pmic, RK817_SOC_REG0, 3);
+	pre_cap = rk817_read(pmic, RK817_REMAIN_CAP_REG0, 3);
+	off = dm_i2c_reg_read(pmic, RK817_OFF_CNT);
+	if ((q >> 24) & RK817_CAP_INVALID || fcc < RK817_MIN_FCC ||
+	    fcc > RK817_QMAX_MAH || pre_soc < 0 || pre_cap < 0 || off < 0) {
+		printf("my355 fg: gauge state unusable (fcc %d), left to the kernel\n",
+		       fcc);
+		return CMD_RET_SUCCESS;
+	}
+	now_cap = q / 1000 * 1720 / 3600 / RK817_SAMPLE_RES;
+	/* Kept for the log even when unused: the only record of the counter's view */
+	cnt_soc = now_cap * RK817_FULL / fcc;
+
+	ocv_soc = rk817_ocv_soc(pmic);
+	if (off && ocv_soc >= 0) {
+		/* A real off: the counter did not survive it, PWRON_VOL is fresh */
+		soc = ocv_soc;
+		now_cap = ocv_soc * fcc / RK817_FULL;
+		by_ocv = true;
+	} else {
+		/* Warm reboot: the counter is sound and PWRON_VOL is stale */
+		soc = pre_soc + (now_cap - pre_cap) * RK817_FULL / fcc;
+		if (abs(soc - cnt_soc) > RK817_MAX_DRIFT)
+			soc = cnt_soc;
+	}
+	soc = clamp(soc, 0, RK817_FULL);
+	cap = clamp(now_cap, 0, fcc);
+	if (cap == fcc)
+		soc = RK817_FULL;
+
+	ret = rk817_write3(pmic, RK817_SOC_REG0, soc) ||
+	      rk817_write3(pmic, RK817_REMAIN_CAP_REG0, cap);
+	/* Reload the counter; Q_INIT_L0 must change for the load to happen */
+	adc = cap * RK817_SAMPLE_RES * 3600 / 1720 * 1000;
+	if ((u32)rk817_read(pmic, RK817_Q_INIT_H3, 4) == adc)
+		adc++;
+	for (i = 0; i < 4 && !ret; i++)
+		ret = dm_i2c_reg_write(pmic, RK817_Q_INIT_H3 + i,
+				       (adc >> (8 * (3 - i))) & 0xff);
+	/* Clearing it is what makes it readable as a flag next boot */
+	ret = ret || dm_i2c_reg_write(pmic, RK817_OFF_CNT, 0);
+	sts = dm_i2c_reg_read(pmic, RK817_FG_INIT);
+	ret = ret || sts < 0 ||
+	      dm_i2c_reg_write(pmic, RK817_FG_INIT, sts | RK817_FG_INIT_DONE);
+	printf("my355 fg: soc %d.%03d -> %d.%03d%%%s, cap %d -> %d mAh of %d, off %d, cnt %d.%03d%%, ocv %d%%%s\n",
+	       pre_soc / 1000, pre_soc % 1000, soc / 1000, soc % 1000,
+	       by_ocv ? " (by ocv)" : "", pre_cap, cap, fcc, off,
+	       cnt_soc / 1000, cnt_soc % 1000,
+	       ocv_soc < 0 ? -1 : ocv_soc / 1000, ret ? ", write failed" : "");
+
+	return ret ? CMD_RET_FAILURE : CMD_RET_SUCCESS;
+}
+
+U_BOOT_LONGHELP(my355,
+	"mark <name>       - add a named bootstage record\n"
+	"my355 log <addr> <max> - copy the console record to <addr>;\n"
+	"                        its length goes in $my355_logsize\n"
+	"my355 cpu <MHz>        - raise vdd_cpu if needed, then set the core clock\n"
+	"my355 fg               - reconcile the RK817 fuel gauge for the kernel");
+
+U_BOOT_CMD_WITH_SUBCMDS(my355, "BaseOS my355 boot helpers", my355_help_text,
+	U_BOOT_SUBCMD_MKENT(mark, 2, 1, do_my355_mark),
+	U_BOOT_SUBCMD_MKENT(log, 3, 1, do_my355_log),
+	U_BOOT_SUBCMD_MKENT(cpu, 2, 1, do_my355_cpu),
+	U_BOOT_SUBCMD_MKENT(fg, 1, 1, do_my355_fg));
