config BR2_PACKAGE_BASEOS_SDL3_IMAGE
	bool "baseos-sdl3-image"
	depends on BR2_PACKAGE_BASEOS_SDL3
	select BR2_PACKAGE_LIBPNG
	select BR2_PACKAGE_JPEG
	select BR2_PACKAGE_WEBP
	select BR2_PACKAGE_WEBP_DEMUX # animated WebP
	select BR2_PACKAGE_WEBP_MUX # WebP save
	help
	  SDL3_image against baseos-sdl3; Buildroot's needs its sdl3.
	  PNG, JPEG and WebP through the system libraries.
