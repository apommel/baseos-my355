config BR2_PACKAGE_MESA_PANFROST
	bool "mesa-panfrost"
	depends on BR2_aarch64
	depends on BR2_INSTALL_LIBSTDCPP
	depends on BR2_TOOLCHAIN_HAS_THREADS_NPTL
	select BR2_PACKAGE_EXPAT
	select BR2_PACKAGE_LIBDRM
	select BR2_PACKAGE_ZLIB
	help
	  Mesa's Panfrost and PanVK in /usr/lib/mesa, beside libmali,
	  which stays the EGL, GLES and GBM provider; baseos-gpu
	  picks one at boot. Buildroot's mesa3d would provide them
	  and need LLVM on the target.
