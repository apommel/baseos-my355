#!/bin/sh
# Shutdown. busybox init runs this before signalling anything and unmounts
# nothing itself, so stop the other processes and unmount here. Otherwise the
# ext4 journals replay on the next boot.

/bin/dd if=/dev/urandom of=/data/random-seed bs=512 count=1 2>/dev/null

. /usr/share/baseos/log.sh

# init gives this script its own session, which killall5 spares.
read -r _l < /proc/$$/stat
set -- ${_l##*) }
SID=$4

# Is any process left besides init, kernel threads, zombies and this session?
# Sets $LEFT to its name.
others() {
	for _p in /proc/[0-9]*; do
		[ "$_p" = /proc/1 ] && continue
		read -r _l < "$_p/stat" 2>/dev/null || continue
		LEFT=${_l#*(}
		LEFT=${LEFT%%)*}
		set -- ${_l##*) }
		case "$1:$4" in Z:*|*:0|*:"$SID") continue ;; esac
		return 0
	done
	return 1
}

log "shutdown"
/sbin/killall5 -15
i=0
while others && [ "$i" -lt 10 ]; do /bin/usleep 100000; i=$((i + 1)); done
if [ "$i" -lt 10 ]; then log "all exited"; else log "killing, $LEFT still running"; fi
/sbin/killall5 -9
i=0
while others && [ "$i" -lt 10 ]; do /bin/usleep 50000; i=$((i + 1)); done

# Everything but / and the system's own mounts, newest first so nested mounts go
# before their parents. Logged first: /data carries the log and is one of them.
log "unmounting"
/bin/sync
for m in $(/usr/bin/awk '$2 != "/" && $2 !~ /^\/(proc|sys|dev)(\/|$)/ && $2 !~ /^\/(run|tmp|var)$/ { print $2 }' /proc/mounts | /usr/bin/tac); do
	/bin/umount "$m" 2>/dev/null && continue
	/bin/mount -o remount,ro "$m" 2>/dev/null && r="read-only" || r="still writable"
	log "umount $m failed, left $r"
done
/bin/mount -o remount,ro / 2>/dev/null
