#!/bin/sh
# my355 base OS early init.
#
# Budget: well under a second on a normal boot. Nothing sleeps; anything slow
# runs in the background. Compared with the H700 rcS this is shorter, because
# the Flip's vendor kernel does more for us:
#
#   * CONFIG_DEVTMPFS_MOUNT=y — the kernel already mounted /dev
#   * Mali is built in (no mali_kbase.ko to insmod, so no 0.7 s to hide)
#   * the display is plain DRM, so there is no sunxi dispdbg debugfs dependency
#
# Boot forensics land in /run/boot-* and /data, because this device has neither
# a UART attached nor a framebuffer console — see
# docs/07-bringup-and-diagnostics.md.

/bin/mount -t proc  -o nodev,noexec,nosuid proc /proc
/bin/mount -t sysfs -o nodev,noexec,nosuid sys  /sys
grep -q ' /dev devtmpfs ' /proc/mounts || /bin/mount -t devtmpfs dev /dev
/bin/mkdir -p /dev/pts /dev/shm
/bin/mount -t devpts -o gid=5,mode=620 devpts /dev/pts
/bin/mount -t tmpfs -o mode=1777,size=256m tmpfs /dev/shm
/bin/mount -t tmpfs -o mode=1777,size=256m tmpfs /tmp
/bin/mount -t tmpfs -o mode=755,size=32m   tmpfs /run

# Builtins only: a marker costs no fork.
mark() {
	read -r _up _rest < /proc/uptime
	echo "$_up" > "$1"
}
mark /run/boot-rcS-start

/bin/mount -t tmpfs -o mode=755,size=64m   tmpfs /var
/bin/mkdir -p /var/lib /var/log /var/tmp /var/empty /var/lib/dbus /run/dbus
/bin/ln -s /run /var/run

/bin/hostname -F /etc/hostname

# Loopback. Nothing here needs the network, but adbd binds a TCP listener during
# start-up and treats the failure as fatal, so without `lo` there is no adb.
/sbin/ifconfig lo 127.0.0.1 netmask 255.0.0.0 up 2>/dev/null

# Persistent state (mmcblk1p4). Survives an A/B slot flip, which moves only the
# rootfs partition. Mount point is baked into the image.
if ! /bin/mount -t ext4 -o rw,noatime /dev/mmcblk1p4 /data 2>/dev/null; then
	/bin/mount -t tmpfs tmpfs /data
fi
mark /run/boot-data-mounted

# A freshly updated set of slots is on trial until a frontend session starts.
# Count the boots that never get that far and restore the previous ones if this
# set cannot. No-op unless an update is in its trial window.
[ -x /usr/sbin/baseos-update ] && /usr/sbin/baseos-update boot-check

# Stable across boots, generated once. /etc/machine-id is a baked symlink, so
# nothing here writes to the root filesystem.
if [ -s /data/machine-id ]; then
	/bin/cp /data/machine-id /run/machine-id
else
	/bin/dd if=/dev/urandom bs=16 count=1 2>/dev/null | /usr/bin/md5sum | \
		/bin/cut -c1-32 > /run/machine-id
	/bin/cp /run/machine-id /data/machine-id
fi

# dbus and BlueZ state. /var is tmpfs, so both are links: stock keeps the
# pairing store on /userdata, which nextui-session shadows with a tmpfs because
# FAT32 rejects BlueZ's MAC-named directories.
/bin/ln -sf /run/machine-id /var/lib/dbus/machine-id
/bin/ln -sf /userdata/bluetooth /var/lib/bluetooth
mark /run/boot-dbus-start
# The system bus, as stock's S30dbus does: NextUI's audiomon.elf connects to it
# at frontend start whether or not Bluetooth is ever used, and exits if it
# cannot. It has <fork/>, so this returns once the socket is listening.
/usr/bin/dbus-daemon --system 2>/dev/null

# Clock, from the RTC (-u: it holds UTC) then NTP. Backgrounded; TLS validates
# certificates against it, so every HTTPS request depends on this.
/sbin/hwclock -u -s 2>/dev/null &
[ -x /etc/init.d/S49ntp ] && /etc/init.d/S49ntp start &

# Restore last boot's entropy seed before anything wants randomness.
[ -f /data/random-seed ] && /bin/cat /data/random-seed > /dev/urandom 2>/dev/null
/bin/dd if=/dev/urandom of=/data/random-seed bs=512 count=1 2>/dev/null &

# First boot only: grow this card's FAT partition to fill the card. Must run
# before it is mounted, and after /data, which holds the staged contents. The
# test is a builtin, so a normal boot does not even spawn the script.
[ -e /data/expanded ] || /usr/sbin/expand-storage

# The frontend card. The right slot holds BaseOS (it is the only slot the SPL
# can boot from), so a NextUI card goes in the LEFT slot and appears as
# mmcblk2p1. Falling back to this card's own FAT partition keeps a single-card
# setup working. NextUI itself is slot-agnostic: nothing in its scripts names a
# block device, only /mnt/SDCARD.
# Mount point and the /mnt/sdcard alias are baked into the image.
/usr/sbin/mount-frontend

# A *.bosupd on either card writes the reserved half of each region, verifies it
# and flips the GPT. An ordinary boot costs a failed glob, plus one read-only
# mount of this card's own volume when it is not the one already mounted.
[ -x /usr/sbin/baseos-update ] && /usr/sbin/baseos-update apply

# Dev extras (SSH + adb over USB), backgrounded so they never serialise boot.
[ -x /etc/init.d/dev ] && /etc/init.d/dev &

mark /run/boot-rcS-done

# Boot record, since /run is tmpfs and this device has no console. The card copy
# is readable from any computer. Backgrounded: no write on the hand-off path.
{
	. /etc/baseos-release 2>/dev/null
	{
		echo "boot $(/bin/date 2>/dev/null)"
		echo "  version   $BASEOS_VERSION ($BASEOS_BUILD)"
		echo "  rcS-start $(/bin/cat /run/boot-rcS-start 2>/dev/null)"
		echo "  data-mnt  $(/bin/cat /run/boot-data-mounted 2>/dev/null)"
		echo "  dbus      $(/bin/cat /run/boot-dbus-start 2>/dev/null)"
		echo "  rcS-done  $(/bin/cat /run/boot-rcS-done 2>/dev/null)"
		echo "  cmdline   $(/bin/cat /proc/cmdline)"
		echo "  mounts    $(/bin/grep -c . /proc/mounts) entries"
		/bin/grep -E 'mmcblk|/data|SDCARD' /proc/mounts | /bin/sed 's/^/    /'
	} > /run/boot-record
	/bin/cat /run/boot-record >> /data/boot.log
	if /bin/grep -q ' /mnt/SDCARD ' /proc/mounts; then
		/bin/cat /run/boot-record >> /mnt/SDCARD/baseos-boot.log
	fi
} 2>/dev/null &
