#!/bin/sh
# Called by NextUI's etc/wifi/wifi_init.sh. No modules to load — the driver is
# built into this kernel — but stock's S36 also seeds the supplicant config, and
# wifi_init.sh starts `wpa_supplicant -c` on that path. Without the file
# wpa_supplicant exits, and NextUI's scan finds nothing to talk to.
#
# The template is ours: stock's placeholder network={ ssid="SSID" } stanza would
# show up in the frontend as a saved network the user never added.
#
# It is also where WiFi's side of the chip's power is decided (wifibt-power):
# start comes before wifi_init.sh waits for wlan0, stop after it stops DHCP.

CONF=/userdata/cfg/wpa_supplicant.conf

case "$1" in
  start|"")
	/usr/sbin/wifibt-power want wifi
	# wifi_init.sh stop kills wpa_supplicant just before a suspend, and on
	# wake it is a zombie until init reaps it (about once a second); its
	# pidof would take that for a running one and start none.
	n=0
	while [ "$n" -lt 20 ] &&
		grep -qs '^[0-9]* (wpa_supplicant) Z' /proc/[0-9]*/stat; do
		/bin/usleep 100000
		n=$((n + 1))
	done
	# Before the frontend binds /userdata this would seed the root
	# filesystem, shadowing the card's copy on every later boot.
	grep -q ' /userdata ' /proc/mounts || exit 0
	[ -f "$CONF" ] && exit 0
	/bin/mkdir -p /userdata/cfg
	/bin/cp /etc/wpa_supplicant.conf "$CONF" || exit 1
	/bin/sync
	;;
  stop)
	# wifi_init.sh blocks the radio itself, with its own rfkill.elf.
	/usr/sbin/wifibt-power release wifi
	;;
esac

exit 0
