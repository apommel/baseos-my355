#!/bin/sh
# Dev conveniences (SSH, SFTP, ADB). rcS backgrounds this.

. /usr/share/baseos/log.sh

# Host keys on /data: stock regenerates them onto tmpfs every boot, so its
# fingerprint keeps changing. /root links to /data/root, the root is read-only.
/bin/mkdir -p /data/dropbear /data/root
for t in rsa ed25519; do
	k=/data/dropbear/dropbear_${t}_host_key
	[ -f "$k" ] || /usr/sbin/dropbearkey -t "$t" -f "$k" >/dev/null 2>&1
done

/usr/sbin/dropbear -r /data/dropbear/dropbear_rsa_host_key \
                   -r /data/dropbear/dropbear_ed25519_host_key 2>/dev/null

# Backgrounded: it waits for functionfs ep1.
[ -x /usr/sbin/usb-gadget-adb ] && /usr/sbin/usb-gadget-adb &

# Only in a MY355_DIAG=1 rootfs: times the frontend's first frame.
[ -x /usr/sbin/baseos-frameprobe ] && /usr/sbin/baseos-frameprobe &

mark /run/boot-dev-done
