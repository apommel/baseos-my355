#!/bin/sh
# Draw a compact status pill for exceptional boot work.
#
# Only rcS draws the full-screen logo, and only when the bootloader left none;
# every later call overlays this pill and leaves the logo around it intact.

SPLASH_BIN="${BASEOS_FBSPLASH:-/usr/bin/fbsplash}"

[ "${1:-}" = "--important" ] || exit 2
shift

# Progress and a message, both required. fbsplash picks the pill over the
# full-screen logo precisely because a message is present, so a call without
# one would repaint the whole panel and erase the boot logo the rest of boot
# exists to preserve.
[ "$#" -ge 2 ] || exit 2
[ -n "$2" ] || exit 2
[ -x "$SPLASH_BIN" ] || exit 0

exec "$SPLASH_BIN" "$@"
