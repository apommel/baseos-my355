#!/bin/sh
# udhcpc event script (busybox). /etc/resolv.conf is a baked symlink here.
RESOLV=/run/resolv.conf
MDNS=/usr/sbin/baseos-mdns

case "$1" in
	deconfig)
		ip addr flush dev "$interface" 2>/dev/null
		ip link set "$interface" up 2>/dev/null
		;;
	bound|renew)
		ip addr flush dev "$interface" 2>/dev/null
		ip addr add "$ip/${mask:-24}" dev "$interface"
		if [ -n "$router" ]; then
			ip route del default dev "$interface" 2>/dev/null
			for r in $router; do
				ip route add default via "$r" dev "$interface"
				break
			done
		fi
		: > "$RESOLV".new
		[ -n "$domain" ] && echo "search $domain" >> "$RESOLV".new
		for d in $dns; do
			echo "nameserver $d" >> "$RESOLV".new
		done
		mv "$RESOLV".new "$RESOLV"
		;;
esac

# Never wait for mDNS probing or the daemon's start-up on the DHCP path.
# A refresh reads the interface as it is then, including a newer lease.
case "$1:$interface" in
	deconfig:wlan0|bound:wlan0|renew:wlan0)
		[ -x "$MDNS" ] && "$MDNS" refresh wlan0 </dev/null >/dev/null 2>&1 &
		;;
esac
exit 0
