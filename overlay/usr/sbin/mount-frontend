#!/bin/sh
# Mount the frontend card on /mnt/SDCARD.
#
# The left slot (mmcblk2p1) is the normal place for it; this card's own FAT
# partition (mmcblk1p5) is the single-card fallback. A card that carries a
# frontend wins, so an empty or ROM-only card in the left slot does not hide a
# frontend installed on the boot card. Exits 0 once something is mounted.

SDCARD=/mnt/SDCARD
. /usr/share/baseos/log.sh

has_frontend() {
	[ -f "$SDCARD/.tmp_update/updater" ] || [ -f "$SDCARD/MinUI.zip" ] ||
		[ -d "$SDCARD/miyoo355/app/.tmp_update" ]
}

splash() { [ -x /usr/bin/baseos-splash ] && \
	/usr/bin/baseos-splash --important "$1" "REPAIRING SD CARD" 2>/dev/null; }

# A dirty flag survives any number of clean mounts until fsck clears it.
# $2: vfat or exfat, $3: the FATs' size in sectors.
repair() {
	fsck=fsck.fat; [ "$2" = exfat ] && fsck=fsck.exfat
	log "$1 was not cleanly unmounted, repairing"
	splash 0
	done=/run/fsck.done
	/bin/rm -f "$done"
	{ /usr/sbin/$fsck -a "$1" >> "$BASEOS_LOG" 2>&1; r=$?; : > "$done"; exit $r; } &
	# fsck reads the FATs first, half the bar; the directories, of unknown
	# size, only creep it towards 95.
	stat=/sys/class/block/${1#/dev/}/stat
	read -r _ _ r0 _ _ _ w0 _ < "$stat"
	until [ -e "$done" ]; do
		/bin/sleep 0.25
		read -r _ _ r _ _ _ w _ < "$stat"
		io=$((r - r0 + w - w0))
		if [ "$io" -lt "$3" ]; then
			splash $((50 * io / $3))
		else
			splash $((50 + 45 * (io - $3) / io))
		fi
	done
	wait $!
	case "$?" in
		0|1) log "$1 repaired" ;;
		*) log "$fsck failed on $1, mounting as it is" ;;
	esac
	splash 100
}

try() {
	info=$(/usr/sbin/fatdirty "$1")
	case $? in
		0) repair "$1" $info ;;
		3) log "$1 dirty but in use, not repairing" ;;
		2) return 1 ;;
	esac
	# vfat would need an NLS table for iocharset=utf8, which this kernel lacks.
	set -- "$1" $info
	opts=iocharset=utf8; [ "$2" = vfat ] && opts=utf8,shortname=mixed
	/bin/mount -t "$2" -o rw,noatime,$opts "$1" "$SDCARD" 2>/dev/null
}

grep -q " $SDCARD " /proc/mounts && exit 0

fallback=""
for dev in /dev/mmcblk2p1 /dev/mmcblk1p5; do
	[ -b "$dev" ] || continue
	try "$dev" || continue
	has_frontend && exit 0
	[ -n "$fallback" ] || fallback="$dev"
	/bin/umount "$SDCARD"
done

[ -n "$fallback" ] && try "$fallback"
