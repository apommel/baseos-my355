#!/bin/sh
# Bring up the BaseOS USB gadget so adb works over the USB-C port.
#
# Reproduces the configfs gadget stock builds with its 700-line vendor
# usbdevice script, reduced to what adb actually needs. The shape was read off
# a running stock unit rather than derived from the script:
#
#   gadget   rockchip           idVendor 0x2207  idProduct 0x0006
#   function ffs.adb            functionfs mounted at /dev/usb-ffs/adb
#   config   b.1 "adb"
#   UDC      fcc00000.dwc3      (the only entry in /sys/class/udc)
#
# This is a convenience and NEVER a boot dependency: no `set -e`, every failure
# path returns quietly, and /etc/init.d/dev backgrounds it so it cannot
# serialise boot.
#
# Because it must not fail loudly, it logs instead — the only way to see anything
# on a device with no console. See docs/diagnostics.md.
#
# Ordering is load-bearing. adbd must be running and have written its
# descriptors into functionfs BEFORE the UDC is bound, or the host sees a
# gadget with no endpoints and enumeration fails.

# Never set: adbd would bind 0.0.0.0:$ADB_TCP_PORT as an open root shell (stock
# ships 5555). USB only. The loopback 5037 smartsocket is separate.
unset ADB_TCP_PORT
export ADBD_SHELL="${ADBD_SHELL:-/bin/sh}"
export USB_FUNCS="${USB_FUNCS:-adb}"
export HOME=/
export PATH=/usr/bin:/usr/sbin:/bin:/sbin

. /usr/share/baseos/log.sh

CONFIGFS=/sys/kernel/config
G="$CONFIGFS/usb_gadget/rockchip"
FFS=/dev/usb-ffs/adb
ADBD=/usr/bin/adbd

log "start"
[ -x "$ADBD" ] || { log "no adbd at $ADBD"; exit 0; }

grep -q " $CONFIGFS " /proc/mounts 2>/dev/null || \
	/bin/mount -t configfs none "$CONFIGFS" 2>/dev/null || { log "configfs mount failed"; exit 0; }
log "configfs ok"

udc=$(ls /sys/class/udc 2>/dev/null | head -1)
[ -n "$udc" ] || { log "no UDC in /sys/class/udc"; exit 0; }
log "udc=$udc"

# androidboot.serialno is what stock advertises; fall back to the machine id so
# two units are never indistinguishable to a host.
serial=$(sed 's/ /\n/g' /proc/cmdline 2>/dev/null | sed -n 's/^androidboot.serialno=//p')
[ -n "$serial" ] || serial=$(cat /etc/machine-id 2>/dev/null) || serial=my355

mkdir -p "$G" 2>/dev/null || { log "cannot create gadget $G"; exit 0; }
log "gadget created"
printf '0x2207' > "$G/idVendor"       2>/dev/null
printf '0x0006' > "$G/idProduct"      2>/dev/null
printf '0x0310' > "$G/bcdDevice"      2>/dev/null
printf '0x0201' > "$G/bcdUSB"         2>/dev/null
mkdir -p "$G/strings/0x409" 2>/dev/null
printf 'rockchip' > "$G/strings/0x409/manufacturer" 2>/dev/null
printf 'miyoo355' > "$G/strings/0x409/product"      2>/dev/null
printf '%s' "$serial" > "$G/strings/0x409/serialnumber" 2>/dev/null

mkdir -p "$G/functions/ffs.adb" 2>/dev/null
mkdir -p "$G/configs/b.1/strings/0x409" 2>/dev/null
printf 'adb' > "$G/configs/b.1/strings/0x409/configuration" 2>/dev/null
printf '500' > "$G/configs/b.1/MaxPower" 2>/dev/null
[ -e "$G/configs/b.1/f-ffs.adb" ] || \
	ln -s "$G/functions/ffs.adb" "$G/configs/b.1/f-ffs.adb" 2>/dev/null

# uid/gid match what the vendor script passes; adbd expects to own these nodes.
mkdir -p "$FFS" 2>/dev/null
grep -q " $FFS " /proc/mounts 2>/dev/null || \
	/bin/mount -t functionfs -o uid=2000,gid=2000 adb "$FFS" 2>/dev/null || \
	{ log "functionfs mount failed"; exit 0; }
log "functionfs mounted: $(ls "$FFS" 2>/dev/null | tr '\n' ' ')"

# adbd writes the descriptors into functionfs; give it a bounded moment to do so.
# Its own stream goes to /data only: it runs for the whole session, and the
# card's copy of the log is on removable FAT.
"$ADBD" >>"$BASEOS_LOG" 2>&1 &
log "adbd started (pid $!)"
i=0
while [ "$i" -lt 100 ]; do
	[ -e "$FFS/ep1" ] && break
	/bin/sleep 0.1
	i=$((i + 1))
done
log "after wait: $(ls "$FFS" 2>/dev/null | tr '\n' ' ')"

printf '%s' "$udc" > "$G/UDC" 2>/dev/null
log "UDC bound -> $(cat "$G/UDC" 2>/dev/null)"
exit 0
