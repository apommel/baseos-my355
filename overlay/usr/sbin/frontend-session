#!/bin/sh
# Frontend session. Respawned by init; replaces the vendor chain
# S60mainui -> runmiyoo.sh -> .tmp_update/updater.
#
# Its contract is the one the NextUI and spruceOS stock hooks share: the card on
# /mnt/SDCARD, then .tmp_update/updater. The frontend sets up the rest itself,
# /userdata included.

SDCARD=/mnt/SDCARD
LOG=/tmp/frontend-session.log

# A session starting is what ends a system-update trial: the OS came up far
# enough to hand off. Keyed here rather than on the frontend exec because a card
# with no frontend is a healthy OS, and keying it later would make that state
# look like a failed update and roll back forever.
# The builtin test is baseos-update's $STATE, sparing the 8 ms no-op.
[ -f /data/update/state ] && [ -x /usr/sbin/baseos-update ] && \
	/usr/sbin/baseos-update confirm 2>/dev/null

# Builtins only: no fork.
uptime_now() {
	read -r _up _rest < /proc/uptime
	echo "$_up"
}

log() {
	line="$(uptime_now) $*"
	echo "$line" >> "$LOG" 2>/dev/null
	# On the mount, not the directory: an unmount window would otherwise
	# leave a stray file on the root filesystem.
	grep -q " $SDCARD " /proc/mounts && \
		echo "$line" >> "$SDCARD/baseos-session.log" 2>/dev/null
}

# The panel is this device's only output. Ordinary boots never call this — the
# bootloader logo stays untouched until the frontend draws its first frame.
splash() {
	[ -x /usr/bin/baseos-splash ] && /usr/bin/baseos-splash --important "$@" 2>/dev/null
}

# The kernel boots on `performance`; a frontend sets its own governor. Without
# one, go back to the kernel's default instead of idling at full speed.
idle_cpu() {
	echo ondemand > /sys/devices/system/cpu/cpufreq/policy0/scaling_governor 2>/dev/null
}

# --- the frontend card ------------------------------------------------------
# rcS is ::sysinit: and mounts once, so a card inserted later would never be
# seen. Mount here too — same devices, options and order — since init respawns
# this script. Same as the H700 port.

# With the left slot empty at boot rcS mounted the fallback, so a card inserted
# later has to displace it: drop the mount and let mount-frontend decide again.
# Safe only here: no frontend is running. A frontend that ran from the fallback
# leaves its /userdata binds on it.
if grep -q "^/dev/mmcblk1p5 $SDCARD " /proc/mounts && [ -b /dev/mmcblk2p1 ]; then
	log "left-slot card present, re-checking which one carries the frontend"
	/bin/sync
	/bin/umount /userdata/bluetooth 2>/dev/null
	/bin/umount /userdata 2>/dev/null
	/bin/umount "$SDCARD" 2>/dev/null
fi

i=0
while [ "$i" -lt 20 ]; do
	/usr/sbin/mount-frontend
	grep -q " $SDCARD " /proc/mounts && break
	/bin/sleep 0.5
	i=$((i + 1))
done
if ! grep -q " $SDCARD " /proc/mounts; then
	log "no card mounted"
	idle_cpu
	splash -1 "INSERT SD CARD"
	# Sleep rather than spin: init respawns us, so pace the retry.
	/bin/sleep 5
	exit 0
fi

# --- first boot from a fresh card ------------------------------------------
# .tmp_update sits inside the base zip's miyoo355/app/, not at the card root.
# On stock it is my355.sh that copies it up — reached through runmiyoo.sh's
# CUSTOMER_DIR and a /proc/cpuinfo shim — and then deletes miyoo355/ so stock
# can never reach it again. Replacing that chain means inheriting the copy; the
# rest of my355.sh is the NAND hook BaseOS exists to replace. miyoo355/ is the
# only customer dir this device reads, so the zip's miyoo/ is left alone.
if [ ! -f "$SDCARD/.tmp_update/updater" ]; then
	if [ -d "$SDCARD/miyoo355/app/.tmp_update" ]; then
		log "staging .tmp_update from miyoo355/app"
		/bin/cp -rf "$SDCARD/miyoo355/app/.tmp_update" "$SDCARD/"
	elif [ -f "$SDCARD/MinUI.zip" ]; then
		# The zip carries the same .tmp_update. Stock has no such fallback.
		log "staging .tmp_update from MinUI.zip"
		/bin/unzip -o "$SDCARD/MinUI.zip" '.tmp_update/*' -d "$SDCARD" >> "$LOG" 2>&1
	fi
	# Only once staging is known good, so a failed copy can try again.
	if [ -f "$SDCARD/.tmp_update/updater" ]; then
		/bin/rm -rf "$SDCARD/miyoo355"
		/bin/sync
	fi
fi

UPDATER="$SDCARD/.tmp_update/updater"
if [ ! -x "$UPDATER" ]; then
	# Two cards is the recommended setup, so with the left slot empty the
	# thing to ask for is the card, not a frontend on this one.
	idle_cpu
	if [ -b /dev/mmcblk2p1 ]; then
		log "no frontend on card"
		splash -1 "ADD FRONTEND TO SD CARD"
	else
		log "no frontend, left slot empty"
		splash -1 "INSERT SD CARD"
	fi
	/bin/sleep 5
	exit 0
fi

# --- hand off ---------------------------------------------------------------
# rcS starts the system bus in the background, and audiomon.elf exits without
# it. It is normally listening by now, so this rarely loops. Bounded at 1 s.
n=0
while [ ! -S /run/dbus/system_bus_socket ] && [ "$n" -lt 100 ]; do
	/bin/usleep 10000
	n=$((n + 1))
done
[ "$n" -eq 0 ] || log "waited $((n * 10)) ms for the system bus"

# Stock calls the updater, not launch.sh directly: it is what installs
# MinUI.zip/*.pakz payloads before starting the frontend. Keeping that entry
# point is what makes updates behave identically.
#
# The H700 port bypasses it and runs the platform script itself, because
# NextUI's installer UI needs libSDL2/_image/_ttf which that rootfs does not
# ship. This one does — they are in the measured harvest — so NextUI can draw
# its own installer and the flow matches stock exactly.
uptime_now > /run/boot-frontend-exec
log "exec $UPDATER"
exec "$UPDATER"
