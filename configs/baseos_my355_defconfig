# BaseOS for the Miyoo Flip (RK3566, Cortex-A55). The package set is
# docs/rootfs-interface.md's tiers.
BR2_aarch64=y
BR2_cortex_a55=y
BR2_DL_DIR="/dl"
BR2_CCACHE=y
BR2_CCACHE_DIR="/build/ccache"
BR2_PER_PACKAGE_DIRECTORIES=y
BR2_GLOBAL_PATCH_DIR="$(BR2_EXTERNAL_BASEOS_PATH)/patches"
BR2_DOWNLOAD_FORCE_CHECK_HASHES=y
BR2_REPRODUCIBLE=y

# Toolchain: glibc, as every stock-built program needs. Headers older than
# the kernel are fine, and changing them rebuilds everything.
BR2_TOOLCHAIN_BUILDROOT_GLIBC=y
BR2_KERNEL_HEADERS_7_1=y
BR2_TOOLCHAIN_BUILDROOT_CXX=y
BR2_GCC_VERSION_15_X=y

# System: BusyBox, static as rcS runs dozens of applets on the boot path;
# init, inittab and the scripts are rootfs-overlay/'s.
BR2_ROOTFS_MERGED_USR=y
BR2_INIT_NONE=y
BR2_PACKAGE_BUSYBOX=y
BR2_PACKAGE_BUSYBOX_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_BASEOS_PATH)/board/my355/busybox.fragment"
BR2_SYSTEM_BIN_SH_BUSYBOX=y
# BR2_TARGET_GENERIC_GETTY is not set
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_BASEOS_PATH)/board/my355/rootfs-overlay"
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_BASEOS_PATH)/board/my355/post-build.sh"
BR2_ROOTFS_POST_FAKEROOT_SCRIPT="$(BR2_EXTERNAL_BASEOS_PATH)/board/my355/post-fakeroot.sh"
BR2_ROOTFS_POST_IMAGE_SCRIPT="$(BR2_EXTERNAL_BASEOS_PATH)/board/my355/post-image.sh"
BR2_PACKAGE_BASEOS_TOOLS=y

# Kernel (docs/mainline-compat.md): hardware/ is the board on mainline,
# stock/ the vendor kernel's interface on top.
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_VERSION=y
BR2_LINUX_KERNEL_CUSTOM_VERSION_VALUE="7.2.10"
BR2_LINUX_KERNEL_PATCH="$(BR2_EXTERNAL_BASEOS_PATH)/board/my355/linux/hardware $(BR2_EXTERNAL_BASEOS_PATH)/board/my355/linux/stock"
BR2_LINUX_KERNEL_USE_CUSTOM_CONFIG=y
BR2_LINUX_KERNEL_CUSTOM_CONFIG_FILE="$(BR2_EXTERNAL_BASEOS_PATH)/board/my355/linux.config"
BR2_LINUX_KERNEL_DTS_SUPPORT=y
BR2_LINUX_KERNEL_CUSTOM_DTS_DIR="$(BR2_EXTERNAL_BASEOS_PATH)/board/my355/linux/dts"
BR2_LINUX_KERNEL_NEEDS_HOST_OPENSSL=y
BR2_PACKAGE_MALI_KBASE=y
BR2_PACKAGE_RTL8733BU=y

# U-Boot proper only (docs/uboot.md); the SPL, BL31 and OP-TEE stay stock's.
BR2_TARGET_UBOOT=y
BR2_TARGET_UBOOT_BUILD_SYSTEM_KCONFIG=y
BR2_TARGET_UBOOT_CUSTOM_VERSION=y
BR2_TARGET_UBOOT_CUSTOM_VERSION_VALUE="2026.01"
BR2_TARGET_UBOOT_PATCH="$(BR2_EXTERNAL_BASEOS_PATH)/board/my355/uboot/patches"
BR2_TARGET_UBOOT_USE_CUSTOM_CONFIG=y
BR2_TARGET_UBOOT_CUSTOM_CONFIG_FILE="$(BR2_EXTERNAL_BASEOS_PATH)/board/my355/uboot.config"
BR2_TARGET_UBOOT_CUSTOM_DTS_PATH="$(BR2_EXTERNAL_BASEOS_PATH)/board/my355/uboot/rk3566-miyoo-flip.dts"
# Buildroot always makes `all`, whose binman images want a BL31: mkfit.py
# builds the FIT from stock's instead.
BR2_TARGET_UBOOT_CUSTOM_MAKEOPTS="ENV_FILE=$(BR2_EXTERNAL_BASEOS_PATH)/board/my355/uboot.env BINMAN_ALLOW_MISSING=1"
BR2_TARGET_UBOOT_NEEDS_DTC=y
BR2_TARGET_UBOOT_NEEDS_PYLIBFDT=y
BR2_TARGET_UBOOT_NEEDS_PYELFTOOLS=y
BR2_TARGET_UBOOT_NEEDS_OPENSSL=y
BR2_PACKAGE_STOCK_FIRMWARE=y

# Images: EROFS, lz4hc in 16 KiB clusters, decoded fast enough to keep up
# with page faults (docs/rootfs.md). post-image.sh composes the card.
BR2_TARGET_ROOTFS_EROFS=y
BR2_TARGET_ROOTFS_EROFS_LZ4HC_LEVEL=12
BR2_TARGET_ROOTFS_EROFS_PCLUSTERSIZE=16384
# For tools/abi_scan.py.
BR2_TARGET_ROOTFS_TAR=y
BR2_PACKAGE_HOST_E2FSPROGS=y
BR2_PACKAGE_HOST_EXFATPROGS=y
BR2_PACKAGE_HOST_ZSTD=y

# Tier 1: linked into frontend processes.
BR2_PACKAGE_LIBMALI=y
BR2_PACKAGE_MESA_PANFROST=y
BR2_PACKAGE_BASEOS_SDL3=y
BR2_PACKAGE_SDL2_COMPAT=y
BR2_PACKAGE_BASEOS_SDL2_IMAGE=y
BR2_PACKAGE_BASEOS_SDL2_TTF=y
BR2_PACKAGE_LIBUDEV_ZERO=y
BR2_PACKAGE_ALSA_LIB=y
BR2_PACKAGE_DBUS=y
BR2_PACKAGE_ZLIB=y
BR2_PACKAGE_VULKAN_LOADER=y

# Tier 2: run by frontends.
BR2_PACKAGE_ALSA_UTILS=y
BR2_PACKAGE_ALSA_UTILS_AMIXER=y
# BR2_PACKAGE_ALSA_UTILS_ALSACTL is not set
# BR2_PACKAGE_ALSA_UTILS_ALSAMIXER is not set
BR2_PACKAGE_LIBDRM_INSTALL_TESTS=y
BR2_PACKAGE_LIBCURL=y
BR2_PACKAGE_LIBCURL_CURL=y
BR2_PACKAGE_LIBCURL_OPENSSL=y
BR2_PACKAGE_WPA_SUPPLICANT=y
BR2_PACKAGE_WPA_SUPPLICANT_NL80211=y
BR2_PACKAGE_WPA_SUPPLICANT_CTRL_IFACE=y
BR2_PACKAGE_WPA_SUPPLICANT_CLI=y
BR2_PACKAGE_WPA_SUPPLICANT_WPA3=y
BR2_PACKAGE_BLUEZ5_UTILS=y
BR2_PACKAGE_BLUEZ5_UTILS_CLIENT=y
# hciconfig and hcitool: deprecated tools, installed only with the tools.
BR2_PACKAGE_BLUEZ5_UTILS_TOOLS=y
BR2_PACKAGE_BLUEZ5_UTILS_DEPRECATED=y
BR2_PACKAGE_BLUEZ5_UTILS_PLUGINS_AUDIO=y
BR2_PACKAGE_BLUEZ5_UTILS_PLUGINS_HID=y
BR2_PACKAGE_BLUEZ5_UTILS_PLUGINS_HOG=y
# BR2_PACKAGE_BLUEZ5_UTILS_PLUGINS_NETWORK is not set
BR2_PACKAGE_BLUEZ_ALSA=y
BR2_PACKAGE_BASH=y
BR2_PACKAGE_E2FSPROGS=y
# BR2_PACKAGE_E2FSPROGS_FSCK is not set

# Tier 3: run by the OS only.
BR2_PACKAGE_ANDROID_TOOLS=y
# BR2_PACKAGE_ANDROID_TOOLS_FASTBOOT is not set
# BR2_PACKAGE_ANDROID_TOOLS_ADB is not set
BR2_PACKAGE_ANDROID_TOOLS_ADBD=y
BR2_PACKAGE_DROPBEAR=y
# BR2_PACKAGE_DROPBEAR_CLIENT is not set
BR2_PACKAGE_DROPBEAR_DISABLE_REVERSEDNS=y
BR2_PACKAGE_GESFTPSERVER=y
BR2_PACKAGE_DOSFSTOOLS=y
BR2_PACKAGE_DOSFSTOOLS_FSCK_FAT=y
BR2_PACKAGE_EXFATPROGS=y
# cfg80211 reads it at load, or every channel stays at the world limits.
BR2_PACKAGE_WIRELESS_REGDB=y

# Tier 4: data read in place.
BR2_PACKAGE_CA_CERTIFICATES=y
BR2_TARGET_TZ_INFO=y

# For frontends to target directly: what NextUI bundles in .system/my355/lib,
# SDL3's add-ons, and common needs. Libraries cost nothing until loaded.
BR2_PACKAGE_BASEOS_SDL3_IMAGE=y
BR2_PACKAGE_BASEOS_SDL3_TTF=y
BR2_PACKAGE_BASEOS_SDL3_MIXER=y
BR2_PACKAGE_SQLITE=y
BR2_PACKAGE_LIBZIP=y
BR2_PACKAGE_ZSTD=y
BR2_PACKAGE_LZ4=y
BR2_PACKAGE_XZ=y
BR2_PACKAGE_BZIP2=y
BR2_PACKAGE_LIBSAMPLERATE=y
BR2_PACKAGE_LIBARCHIVE=y
BR2_PACKAGE_CJSON=y
BR2_PACKAGE_LIBEVDEV=y

# Developer tools, run by hand over adb (BusyBox has the i2c-tools applets).
BR2_PACKAGE_GDB=y
BR2_PACKAGE_GDB_SERVER=y
# BR2_PACKAGE_GDB_DEBUGGER is not set
BR2_PACKAGE_STRACE=y
BR2_PACKAGE_EVTEST=y
BR2_PACKAGE_IW=y
BR2_PACKAGE_ALSA_UTILS_APLAY=y
BR2_PACKAGE_ALSA_UTILS_SPEAKER_TEST=y

# The SDK (make sdk): environment-setup sets CC, PKG_CONFIG, ...
BR2_PACKAGE_HOST_ENVIRONMENT_SETUP=y
