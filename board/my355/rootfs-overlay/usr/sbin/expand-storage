#!/bin/sh
# First boot: grow the card's exFAT partition to fill the card and format it
# (exFAT cannot grow in place). It ships empty, and stock cannot write to it, so
# nothing on it is kept. The preloader installer's backup and log move here
# from /data, removed there only once the copies are synced.

DISK=/dev/mmcblk1
PART=/dev/mmcblk1p5             # `primary`, GPT entry 5 (tools/mkgpt.py)
MNT=/tmp/.primary
GROWN=/data/expand-grown
DONE=/data/expanded
README=/usr/share/baseos/card-readme.txt
. /usr/share/baseos/log.sh

splash() { [ -x /usr/bin/baseos-splash ] && \
	/usr/bin/baseos-splash --important "$1" "EXPANDING STORAGE" 2>/dev/null; }

[ -e "$DONE" ] && exit 0
[ -b "$PART" ] || exit 0

# 0 = grown, 1 = already fills the card, 2 = error. $GROWN covers a power cut
# before the format below.
if [ ! -e "$GROWN" ]; then
	/usr/sbin/gptgrow "$DISK" primary >> "$BASEOS_LOG" 2>&1
	case "$?" in
		0) log "grown"; /bin/touch "$GROWN"; /bin/sync ;;
		1) /bin/touch "$DONE"; exit 0 ;;  # not a card we grew: leave it alone
		*) log "gptgrow failed; partition untouched"; exit 1 ;;
	esac
fi
splash 30

/usr/sbin/mkfs.exfat -L BASEOS "$PART" >> "$BASEOS_LOG" 2>&1 || { log "mkfs.exfat failed"; exit 1; }
splash 70

/bin/mkdir -p "$MNT" && /bin/mount -t exfat "$PART" "$MNT" ||
	{ log "cannot mount the new filesystem"; exit 1; }
/bin/cp "$README" "$MNT/README.txt"
/bin/cp /usr/share/baseos/baseos.conf "$MNT/"
moved=
for f in /data/mtd5-original-*.img /data/baseos-preloader.log; do
	[ -f "$f" ] && /bin/cp "$f" "$MNT/" 2>> "$BASEOS_LOG" && moved="$moved $f"
done
/bin/sync
/bin/umount "$MNT"
/bin/rm -f $moved "$GROWN"
/bin/touch "$DONE"
# Before the sync, not after: this device is powered off with the button, and a
# line written after the last flush is the one an unclean shutdown loses.
log "expanded to fill the card"
/bin/sync
splash 100
