#!/bin/sh
# The GPU stack that baseos.conf's gpu= picks, set up by rcS before the
# frontend starts: panfrost (the default: Mesa) or mali (libmali and mali_kbase).

. /usr/share/baseos/log.sh
. /usr/share/baseos/conf.sh

conf_get gpu
case "$CONF_VALUE" in
	mali|panfrost) gpu=$CONF_VALUE ;;
	'') gpu=panfrost ;;
	*) log "baseos.conf: unknown gpu=$CONF_VALUE, using panfrost"; gpu=panfrost ;;
esac

if [ "$gpu" = panfrost ]; then
	# Everything finds these by soname in /usr/lib, so Mesa's go over libmali's;
	# NextUI links libmali itself.
	for l in libmali.so.1 libmali_hook.so.1 libEGL.so.1 libGLESv1_CM.so.1 \
		libGLESv2.so.2 libgbm.so.1; do
		/bin/mount --bind "/usr/lib/mesa/$l" "/usr/lib/$l"
	done
	# The Vulkan loader reads ICDs from here.
	/bin/mount --bind /usr/lib/mesa/vulkan /usr/share/vulkan
	module=panfrost
	set -- /usr/lib/mesa/libgallium-*.so
	lib=$1
else
	module=mali_kbase
	lib=/usr/lib/libmali.so.1
fi
# Every frontend program links it, and the first would fault it in page by page.
# Read now, behind whatever else boot reads.
/usr/bin/ionice -c3 /bin/cat "$lib" > /dev/null &
echo "$gpu" > /run/gpu
# Backgrounded: nothing in rcS draws with it.
{ /sbin/modprobe "$module" && mark /run/boot-gpu; } &
