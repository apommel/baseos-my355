#!/bin/sh
# The GPU stack that flipbase.conf's gpu= picks, set up by rcS before the
# frontend starts: panfrost (the default: Mesa) or mali (libmali and mali_kbase).

. /usr/share/flipbase/log.sh
. /usr/share/flipbase/conf.sh

conf_get gpu
case "$CONF_VALUE" in
	mali|panfrost) gpu=$CONF_VALUE ;;
	'') gpu=panfrost ;;
	*) log "flipbase.conf: unknown gpu=$CONF_VALUE, using panfrost"; gpu=panfrost ;;
esac

# The GPU library names in /usr/lib and the Vulkan ICDs link through here
# (post-build.sh).
/bin/mkdir -p /run/flipbase
if [ "$gpu" = panfrost ]; then
	/bin/ln -sfn /usr/lib/mesa /run/flipbase/gpu
	module=panfrost
	set -- /usr/lib/mesa/libgallium-*.so
	lib=$1
else
	/bin/ln -sfn /usr/lib/mali /run/flipbase/gpu
	module=mali_kbase
	lib=/usr/lib/libmali.so.1
fi
# Every frontend program links it, and the first would fault it in page by page.
# Read now, behind whatever else boot reads.
/usr/bin/ionice -c3 /bin/cat "$lib" > /dev/null &
echo "$gpu" > /run/gpu
# Backgrounded: nothing in rcS draws with it.
{ /sbin/modprobe "$module" && mark /run/boot-gpu; } &
