#!/bin/sh
# Stands in for the stock daemon frontends start: MIYOO Player1 is the
# kernel's miyoo-player1 driver. Like the daemon, it hands over the stock
# calibration files, at start and on cal_update, and passes
# on its turbo files: turbo_<button>, under enable_turbo_input. It stays so the
# frontend still finds it running.
for n in /sys/class/input/input*/name; do
	[ "$(cat "$n" 2>/dev/null)" = "MIYOO Player1" ] && d=${n%/name}/device
done
[ -n "$d" ] || exec /bin/sleep 2147483647

T=/tmp/miyoo_inputd
calibrate() {
	[ -f /userdata/joypad.config ] && cat /userdata/joypad.config > "$d/calibration_left"
	[ -f /userdata/joypad_right.config ] && cat /userdata/joypad_right.config > "$d/calibration_right"
}
turbo() {
	[ -e $T/enable_turbo_input ] || { echo > "$d/turbo"; return; }
	echo $(cd $T && ls | sed -n 's/^turbo_//p') > "$d/turbo"
}
mkdir -p $T
rm -f $T/cal_update
calibrate
turbo
inotifyd - $T:nd | while read -r e _ f; do
	case $e$f in
	ncal_update) calibrate; rm -f $T/cal_update ;;
	*) turbo ;;
	esac
done
