#!/bin/sh
# DHCP on wlan0. Called by NextUI's etc/wifi/wifi_init.sh, which is where the
# dhcpcd name comes from; BaseOS uses BusyBox udhcpc.

IFACE=wlan0
PIDFILE=/run/udhcpc.$IFACE.pid

case "$1" in
  start)
	[ -s "$PIDFILE" ] && [ -d "/proc/$(cat "$PIDFILE")" ] && exit 0
	# Called before wpa_supplicant, so -b would block 15 s then pause 20 s
	# (docs/rootfs.md). The hostname lets the router name the lease.
	/usr/bin/setsid /sbin/udhcpc -f -i "$IFACE" -T 1 -A 2 -p "$PIDFILE" \
		-x hostname:"$(/bin/hostname)" >/dev/null 2>&1 &
	;;
  stop)
	[ -s "$PIDFILE" ] && kill "$(cat "$PIDFILE")" 2>/dev/null
	rm -f "$PIDFILE"
	;;
  restart)
	"$0" stop
	"$0" start
	;;
  *)
	echo "Usage: $0 {start|stop|restart}"
	exit 1
esac
