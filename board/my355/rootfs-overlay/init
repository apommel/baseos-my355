#!/bin/sh
# PID 1 entry point.
#
# The kernel is told to run this explicitly via `init=/init` on the command
# line, because for a DISK root it would otherwise only try /sbin/init,
# /etc/init, /bin/init and /bin/sh — `/init` is the initramfs convention.
# Getting that wrong costs a silent hang: the kernel finds /bin/sh, execs it,
# and the shell waits forever on a console this device does not have.
# See docs/card.md.

# The logo first, so the panel's power-up in the first modeset runs beside init
# and rcS. Unblanking starts it before fbsplash has loaded its libraries. The
# kernel line is flipbase-bootinfo's logo marker: no /proc yet.
/bin/mount -t sysfs -o nodev,noexec,nosuid sys /sys
echo 0 > /sys/class/graphics/fb0/blank &
{ /usr/bin/fbsplash 0 </dev/null >/dev/null 2>&1 &&
	echo 'flipbase: logo on the panel' > /dev/kmsg; } &

exec /bin/busybox init
