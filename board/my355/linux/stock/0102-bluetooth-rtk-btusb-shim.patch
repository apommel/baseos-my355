Subject: [PATCH] Bluetooth: stock rtk_btusb, loading btusb

---
diff --git a/drivers/bluetooth/Kconfig b/drivers/bluetooth/Kconfig
index 4e8c24d75..890e8ee59 100644
--- a/drivers/bluetooth/Kconfig
+++ b/drivers/bluetooth/Kconfig
@@ -473,3 +473,7 @@ config BT_INTEL_PCIE
 	  Say Y here to compiler support for Intel Bluetooth PCIe device into
 	  the kernel or say M to compile it as module (btintel_pcie)
 endmenu
+
+config BT_RTK_BTUSB_SHIM
+	tristate "Stock rtk_btusb, loading btusb"
+	depends on BT_HCIBTUSB
diff --git a/drivers/bluetooth/Makefile b/drivers/bluetooth/Makefile
index e6b1c1180..3d41bfe92 100644
--- a/drivers/bluetooth/Makefile
+++ b/drivers/bluetooth/Makefile
@@ -52,3 +52,4 @@ hci_uart-$(CONFIG_BT_HCIUART_AML)	+= hci_aml.o
 hci_uart-objs				:= $(hci_uart-y)
 
 CONTEXT_ANALYSIS := y
+obj-$(CONFIG_BT_RTK_BTUSB_SHIM) += rtk_btusb.o
diff --git a/drivers/bluetooth/rtk_btusb.c b/drivers/bluetooth/rtk_btusb.c
new file mode 100644
index 000000000..727540ad8
--- /dev/null
+++ b/drivers/bluetooth/rtk_btusb.c
@@ -0,0 +1,25 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Stands in for the vendor's rtk_btusb.ko, at the path NextUI's bt_init.sh
+ * insmods: its loading is what tells FlipBase (wifibtd) to power the chip.
+ * Bluetooth itself is mainline's btusb, loaded after 8733bu: the other order
+ * resets the shared chip and takes wlan0 down.
+ */
+#include <linux/kmod.h>
+#include <linux/module.h>
+
+static int __init rtk_btusb_init(void)
+{
+	request_module("8733bu");
+	request_module("btusb");
+	return 0;
+}
+module_init(rtk_btusb_init);
+
+static void __exit rtk_btusb_exit(void)
+{
+}
+module_exit(rtk_btusb_exit);
+
+MODULE_DESCRIPTION("Stock's rtk_btusb, loading mainline's btusb");
+MODULE_LICENSE("GPL");
