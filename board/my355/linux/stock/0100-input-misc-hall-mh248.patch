Subject: [PATCH] Input: misc: lid sensor as stock hall-mh248

---
--- a/drivers/input/misc/Kconfig
+++ b/drivers/input/misc/Kconfig
@@ -994,3 +994,7 @@
 	  module will be called stpmic1_onkey.
 
 endif
+
+config INPUT_HALL_MH248
+	tristate "Miyoo Flip lid sensor, as hall-mh248"
+	depends on INPUT_MISC && GPIOLIB && OF
--- a/drivers/input/misc/Makefile
+++ b/drivers/input/misc/Makefile
@@ -95,3 +95,4 @@
 obj-$(CONFIG_INPUT_XEN_KBDDEV_FRONTEND)	+= xen-kbdfront.o
 obj-$(CONFIG_INPUT_YEALINK)		+= yealink.o
 obj-$(CONFIG_INPUT_IDEAPAD_SLIDEBAR)	+= ideapad_slidebar.o
+obj-$(CONFIG_INPUT_HALL_MH248) += hall-mh248.o
--- a/drivers/input/misc/hall-mh248.c
+++ b/drivers/input/misc/hall-mh248.c
@@ -0,0 +1,130 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * The Miyoo Flip's lid sensor: SW_LID, as mainline lid switches report it,
+ * and stock's hall-mh248 on top: hallvalue in sysfs (1 open, 0 closed) and
+ * KEY_POWER from "hall wake key" when the lid moves. Stock sends that on close
+ * with the screen on and on open with it off; without an fb notifier, this
+ * sends it on both.
+ *
+ * Probed before the PMIC's power key, so it is event1, the device NextUI's
+ * launch.sh moves aside.
+ */
+#include <linux/gpio/consumer.h>
+#include <linux/input.h>
+#include <linux/interrupt.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+#include <linux/pm_wakeirq.h>
+
+struct hall {
+	struct input_dev *input;
+	struct gpio_desc *gpio;
+	int active;		/* raw level with the lid open */
+	bool open;
+};
+
+static bool hall_open(struct hall *hall)
+{
+	return gpiod_get_raw_value_cansleep(hall->gpio) == hall->active;
+}
+
+static irqreturn_t hall_irq(int irq, void *data)
+{
+	struct hall *hall = data;
+	bool open = hall_open(hall);
+
+	if (open == hall->open)
+		return IRQ_HANDLED;
+	hall->open = open;
+	input_report_switch(hall->input, SW_LID, !open);
+	input_report_key(hall->input, KEY_POWER, 1);
+	input_sync(hall->input);
+	input_report_key(hall->input, KEY_POWER, 0);
+	input_sync(hall->input);
+	return IRQ_HANDLED;
+}
+
+static ssize_t hallvalue_show(struct device *dev, struct device_attribute *attr,
+			      char *buf)
+{
+	return sysfs_emit(buf, "%d\n", hall_open(dev_get_drvdata(dev)));
+}
+static DEVICE_ATTR_RO(hallvalue);
+
+static struct attribute *hall_attrs[] = {
+	&dev_attr_hallvalue.attr,
+	NULL
+};
+ATTRIBUTE_GROUPS(hall);
+
+static int hall_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct hall *hall;
+	u32 active = 1;
+	int irq, ret;
+
+	hall = devm_kzalloc(dev, sizeof(*hall), GFP_KERNEL);
+	if (!hall)
+		return -ENOMEM;
+	of_property_read_u32(dev->of_node, "hall-active", &active);
+	hall->active = active;
+	hall->gpio = devm_gpiod_get(dev, "irq", GPIOD_IN);
+	if (IS_ERR(hall->gpio))
+		return dev_err_probe(dev, PTR_ERR(hall->gpio), "no irq-gpio\n");
+	hall->open = hall_open(hall);
+	platform_set_drvdata(pdev, hall);
+
+	hall->input = devm_input_allocate_device(dev);
+	if (!hall->input)
+		return -ENOMEM;
+	hall->input->name = "hall wake key";
+	hall->input->phys = "hall-mh248/input0";
+	hall->input->id.bustype = BUS_HOST;
+	input_set_capability(hall->input, EV_KEY, KEY_POWER);
+	input_set_capability(hall->input, EV_SW, SW_LID);
+	ret = input_register_device(hall->input);
+	if (ret)
+		return ret;
+	input_report_switch(hall->input, SW_LID, !hall->open);
+	input_sync(hall->input);
+
+	irq = gpiod_to_irq(hall->gpio);
+	if (irq < 0)
+		return irq;
+	ret = devm_request_threaded_irq(dev, irq, NULL, hall_irq,
+					IRQF_TRIGGER_RISING | IRQF_TRIGGER_FALLING |
+					IRQF_ONESHOT, "hall_mh248", hall);
+	if (ret)
+		return ret;
+
+	device_init_wakeup(dev, true);
+	return dev_pm_set_wake_irq(dev, irq);
+}
+
+static void hall_remove(struct platform_device *pdev)
+{
+	dev_pm_clear_wake_irq(&pdev->dev);
+	device_init_wakeup(&pdev->dev, false);
+}
+
+static const struct of_device_id hall_of_match[] = {
+	{ .compatible = "hall-mh248" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, hall_of_match);
+
+static struct platform_driver hall_driver = {
+	.driver = {
+		.name = "hall-mh248",
+		.of_match_table = hall_of_match,
+		.dev_groups = hall_groups,
+	},
+	.probe = hall_probe,
+	.remove = hall_remove,
+};
+module_platform_driver(hall_driver);
+
+MODULE_DESCRIPTION("Miyoo Flip lid sensor, as stock's hall-mh248");
+MODULE_LICENSE("GPL");
