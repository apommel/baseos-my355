/* The boot script (docs/uboot.md). Addresses: tools/mkfit.py's DRAM map. */

/* Charging while off stays in U-Boot; then the panel's supply. */
#define CHARGE my355 charge;
#define PANEL gpio set A23;
/* May fail: the CPU clock, the fuel gauge, a block cache for the GPT. */
#define PREP my355 cpu 1104; my355 mark cpu_set; my355 fg; my355 mark fg_sync; \
	blkcache configure 32 32;
/* May not fail. `boot` by name, as an update moves it. */
#define LOAD mmc dev 1 && my355 mark mmc_ready && \
	part start mmc 1 boot bs && part size mmc 1 boot bz && \
	setexpr lg ${bs} + ${bz} && setexpr lg ${lg} - 80 && \
	mmc read c000000 ${bs} 1 && \
	setexpr.l m *c000000 && test ${m} = 3533594d && \
	setexpr.l m *c000004 && test ${m} = 54494635 && \
	setexpr.l n *c000008 && setexpr fs ${bs} + 1 && \
	mmc read a000000 ${fs} ${n} && my355 mark fit_read
/* Decompress at 1800 MHz; the kernel must start at 1104. */
#define BOOT env exists ok && my355 cpu 1800; \
	env exists ok && bootm start a000000 && bootm loados && \
	my355 mark decompressed && my355 cpu 1104 && bootm prep && bootm go

#ifdef CONFIG_CONSOLE_RECORD
/* Diag: the charge LED lit until the FIT is read, the card's clock and
 * phases, and the console saved to the boot slot's last 64 KiB. */
#define SAVELOG env exists lg && mw.b c100000 0 10000 && \
	my355 log c100000 10000 && mmc write c100000 ${lg} 80
bootcmd=CHARGE PANEL gpio set A18; PREP LOAD && gpio clear A18 && setenv ok 1; mmc info; md.l fdd20580 2; SAVELOG; BOOT; SAVELOG; poweroff
#else
bootcmd=CHARGE PANEL PREP LOAD && setenv ok 1; BOOT; poweroff
#endif
