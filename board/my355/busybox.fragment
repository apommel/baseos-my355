# On top of Buildroot's busybox.config.
CONFIG_STATIC=y
# rootfs-overlay/ has /init.
# CONFIG_LINUXRC is not set
# rcS's `swapon -p 100`: without it the call fails and zram0 never swaps.
CONFIG_FEATURE_SWAPON_PRI=y

# The rest of the applets earlier BaseOS shipped (Alpine's busybox-static), as
# card scripts may call any of them.
CONFIG_ACPID=y
CONFIG_ADD_SHELL=y
CONFIG_ADJTIMEX=y
CONFIG_BBCONFIG=y
CONFIG_BEEP=y
CONFIG_BLKDISCARD=y
CONFIG_BLOCKDEV=y
CONFIG_BRCTL=y
CONFIG_BZIP2=y
CONFIG_CAL=y
CONFIG_CHPASSWD=y
CONFIG_COMM=y
CONFIG_CRYPTPW=y
CONFIG_DEPMOD=y
CONFIG_EXPAND=y
CONFIG_FATATTR=y
CONFIG_FINDFS=y
CONFIG_FSYNC=y
CONFIG_GROUPS=y
CONFIG_HD=y
CONFIG_IFENSLAVE=y
CONFIG_INOTIFYD=y
CONFIG_IONICE=y
CONFIG_IOSTAT=y
CONFIG_IPCALC=y
CONFIG_KBD_MODE=y
CONFIG_LOGREAD=y
CONFIG_LZOP=y
CONFIG_MAKEMIME=y
CONFIG_MKFS_VFAT=y
CONFIG_MODINFO=y
CONFIG_MPSTAT=y
CONFIG_NANDDUMP=y
CONFIG_NANDWRITE=y
CONFIG_NBDCLIENT=y
CONFIG_NC=y
CONFIG_NMETER=y
CONFIG_NSENTER=y
CONFIG_NTPD=y
CONFIG_PGREP=y
CONFIG_PING6=y
CONFIG_PKILL=y
CONFIG_PMAP=y
CONFIG_PSCAN=y
CONFIG_PSTREE=y
CONFIG_PWDX=y
CONFIG_RAIDAUTORUN=y
CONFIG_RDEV=y
CONFIG_READAHEAD=y
CONFIG_REFORMIME=y
CONFIG_REMOVE_SHELL=y
CONFIG_REV=y
CONFIG_RFKILL=y
CONFIG_SENDMAIL=y
CONFIG_SETFONT=y
CONFIG_SHOWKEY=y
CONFIG_SHUF=y
CONFIG_SLATTACH=y
CONFIG_SPLIT=y
CONFIG_SSL_CLIENT=y
CONFIG_STAT=y
CONFIG_SUM=y
CONFIG_TAC=y
CONFIG_TIMEOUT=y
CONFIG_TRACEROUTE6=y
CONFIG_TTYSIZE=y
CONFIG_TUNCTL=y
CONFIG_UDHCPC6=y
CONFIG_UNEXPAND=y
CONFIG_UNSHARE=y
CONFIG_VOLNAME=y
CONFIG_WHOIS=y
CONFIG_ZCIP=y
