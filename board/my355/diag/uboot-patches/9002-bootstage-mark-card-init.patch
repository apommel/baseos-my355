--- a/drivers/block/blk-uclass.c
+++ b/drivers/block/blk-uclass.c
@@ -7,6 +7,7 @@
 #define LOG_CATEGORY UCLASS_BLK
 
 #include <blk.h>
+#include <bootstage.h>
 #include <dm.h>
 #include <log.h>
 #include <malloc.h>
@@ -831,11 +832,14 @@
 	if (CONFIG_IS_ENABLED(PARTITIONS) && blk_enabled()) {
 		struct blk_desc *desc = dev_get_uclass_plat(dev);
 
+		bootstage_mark_name(BOOTSTAGE_ID_ALLOC, "blk_probe");
 		part_init(desc);
+		bootstage_mark_name(BOOTSTAGE_ID_ALLOC, "blk_part_init");
 
 		if (desc->part_type != PART_TYPE_UNKNOWN &&
 		    part_create_block_devices(dev))
 			debug("*** creating partitions failed\n");
+		bootstage_mark_name(BOOTSTAGE_ID_ALLOC, "blk_part_devs");
 	}
 
 	return 0;
